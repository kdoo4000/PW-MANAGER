                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="show-summary-grid show-header-summary-grid">
                        <ui:VisualElement class="show-summary-cell">
                            <ui:Label name="show-match-count" text="0" class="show-summary-value"/>
                            <ui:Label text="경기" class="show-summary-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="show-summary-cell">
                            <ui:Label name="show-promo-count" text="0" class="show-summary-value blue-text"/>
                            <ui:Label text="프로모" class="show-summary-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="show-summary-cell show-summary-cell-last">
                            <ui:Label name="show-participant-count" text="0" class="show-summary-value green"/>
                            <ui:Label text="출연 선수" class="show-summary-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="show-header-actions">
                        <ui:Button name="show-save-draft" text="임시 저장" class="show-save-button"/>
                        <ui:Button name="show-confirm" text="편성 확정" class="show-confirm-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="show-planning-body">
                    <ui:VisualElement class="show-timeline-panel show-plan-card">
                        <ui:VisualElement class="show-timeline-heading" style="margin-bottom: 0;">
                            <ui:Label text="타임라인" class="show-timeline-title"/>
                            <ui:Label name="show-event-count" text="0개 세그먼트" class="show-panel-caption"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="show-summary-panel show-plan-card show-timeline-summary" style="margin-top: 12px;">
                            <ui:VisualElement class="show-duration-row" style="margin-top: 0;">
                                <ui:Label name="show-duration-used" text="0분 사용" class="show-duration-value" style="margin-top: 2px; padding-top: 2px; margin-bottom: 4px;"/>
                                <ui:Label name="show-duration-limit" text="총 0분" class="show-panel-caption" style="margin-top: 2px; padding-top: 2px; margin-bottom: 4px;"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="show-duration-track" style="margin-bottom: 3px;">
                                <ui:VisualElement name="show-duration-fill" class="show-duration-fill"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="show-add-actions">
                            <ui:Button name="show-add-match" text="경기 추가" class="show-action-button"/>
                            <ui:Button name="show-add-promo" text="프로모 추가" class="show-action-button promo"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="show-timeline-scroll" mode="Vertical" class="show-timeline-scroll">
                            <ui:VisualElement name="show-timeline-rows" class="show-timeline-rows"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="show-detail-column">
                        <ui:VisualElement class="show-detail-panel show-plan-card">
                            <ui:VisualElement class="show-panel-heading">
                                <ui:Label text="선택한 세그먼트" class="show-panel-title"/>
                                <ui:Label name="show-detail-kind" text="—" class="show-kind-chip"/>
                            </ui:VisualElement>
                            <ui:Label name="show-detail-title" text="타임라인에서 항목을 선택하세요" class="show-detail-title"/>
                            <ui:Label name="show-detail-subtitle" text="경기 또는 프로모의 구성 정보를 확인할 수 있습니다" class="show-detail-subtitle"/>
                            <ui:Button name="show-edit-rules" class="show-edit-card show-edit-rules-card">
                                <ui:Label text="규칙" class="show-edit-card-title"/>
                                <ui:Label name="show-detail-rules-summary" text="경기 유형과 결과 방식을 설정합니다" class="show-edit-card-summary"/>
                            </ui:Button>
                            <ui:VisualElement name="show-edit-participants" class="show-edit-card show-edit-participants-card">
                                <ui:Label text="참가자" class="show-edit-card-title"/>
                                <ui:VisualElement name="show-detail-participants" class="show-participant-list"/>
                            </ui:VisualElement>
                            <ui:Button name="show-edit-spots" class="show-edit-card show-edit-spots-card">
                                <ui:Label text="스팟" class="show-edit-card-title"/>
                                <ui:Label name="show-detail-spots-summary" text="설정된 스팟 없음" class="show-edit-card-summary"/>
                            </ui:Button>
                            <ui:VisualElement class="show-detail-info-row">
                                <ui:Label text="배정 시간"/>
                                <ui:Label name="show-detail-duration" text="—" class="show-detail-info-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="show-detail-info-row">
                                <ui:Label text="카드 위치"/>
                                <ui:Label name="show-detail-position" text="—" class="show-detail-info-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="show-detail-actions">
                                <ui:Button name="show-move-up" text="위로" class="show-detail-action"/>
                                <ui:Button name="show-move-down" text="아래로" class="show-detail-action"/>
                                <ui:Button name="show-remove-event" text="삭제" class="show-detail-action danger"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="show-editor-overlay" class="show-editor-overlay hidden">
                    <ui:VisualElement class="show-editor-dialog">
                        <ui:VisualElement class="show-editor-heading">
                            <ui:VisualElement>
                                <ui:Label name="show-editor-title" text="경기 추가" class="show-editor-title"/>
                            </ui:VisualElement>
                            <ui:Button name="show-editor-close" text="×" class="show-editor-close"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="show-editor-fields">
                            <ui:DropdownField name="show-editor-primary" label="경기 유형" class="show-editor-field"/>
                            <ui:DropdownField name="show-editor-secondary" label="경기 방식" class="show-editor-field"/>
                            <ui:DropdownField name="show-editor-duration" label="배정 시간" class="show-editor-field duration"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="show-editor-match-rules" class="show-editor-match-rules hidden">
                            <ui:VisualElement class="show-editor-rule-column">
                                <ui:Label text="규칙 선택" class="show-editor-rule-title"/>
                                <ui:ScrollView mode="Vertical" class="show-editor-rule-scroll">
                                    <ui:VisualElement name="show-editor-rule-options" class="show-editor-rule-options"/>
                                </ui:ScrollView>
                            </ui:VisualElement>
                            <ui:VisualElement class="show-editor-rule-divider">
                                <ui:Label text="›" class="show-editor-rule-arrow"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="show-editor-rule-column">
                                <ui:Label text="기믹 선택" class="show-editor-rule-title"/>
                                <ui:ScrollView mode="Vertical" class="show-editor-rule-scroll">
                                    <ui:VisualElement name="show-editor-gimmick-options" class="show-editor-rule-options"/>
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="show-editor-spots" class="show-editor-spots hidden">
                            <ui:TextField name="show-editor-opening-spot" label="오프닝 스팟" multiline="true" class="show-editor-spot-field"/>
                            <ui:TextField name="show-editor-middle-spot" label="중반 스팟" multiline="true" class="show-editor-spot-field"/>
                            <ui:TextField name="show-editor-closing-spot" label="마무리 스팟" multiline="true" class="show-editor-spot-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="show-editor-roster-heading">
                            <ui:Label text="출연 선수" class="show-editor-section-title"/>
                            <ui:Label name="show-editor-selected-count" text="0명 선택" class="show-editor-selected-count"/>
                        </ui:VisualElement>
                        <ui:ScrollView mode="Vertical" class="show-editor-roster-scroll">
                            <ui:VisualElement name="show-editor-roster" class="show-editor-roster"/>
                        </ui:ScrollView>
                        <ui:Label name="show-editor-message" text="" class="show-editor-message"/>
                        <ui:VisualElement class="show-editor-footer">
                            <ui:Button name="show-editor-cancel" text="취소" class="show-editor-cancel"/>
                            <ui:Button name="show-editor-submit" text="추가" class="show-editor-submit"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="wrestler-profile-content" class="dashboard-profile-content hidden" style="display: none;">
                <ui:Instance template="WrestlerProfileTemplate" class="dashboard-profile-template"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dashboard-save-load-overlay" class="save-load-overlay hidden">
            <ui:VisualElement class="save-load-dialog">
                <ui:VisualElement class="save-load-heading">
                    <ui:VisualElement>
                        <ui:Label text="저장 / 불러오기" class="save-load-title"/>
                        <ui:Label text="수동 저장을 만들거나 기존 게임을 불러옵니다" class="save-load-copy"/>
                    </ui:VisualElement>
                    <ui:Button name="dashboard-save-load-close" text="×" class="save-load-close"/>
                </ui:VisualElement>
                <ui:VisualElement class="manual-save-row">
                    <ui:TextField name="manual-save-name" value="manual_save" class="manual-save-input"/>
                    <ui:Button name="manual-save-submit" text="수동 저장" class="manual-save-button"/>
                </ui:VisualElement>
                <ui:Label name="save-load-message" text="" class="save-load-message"/>
                <ui:ScrollView mode="Vertical" class="save-load-scroll">
                    <ui:VisualElement name="dashboard-save-load-rows" class="save-load-rows"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
