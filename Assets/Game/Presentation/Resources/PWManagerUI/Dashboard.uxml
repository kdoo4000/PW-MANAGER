<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="WrestlerProfileTemplate" src="project://database/Assets/Game/Presentation/Resources/PWManagerUI/WrestlerProfile.uxml?fileID=9197481963319205126&amp;guid=e203f0bcacfc76c439e67eb811528a2e&amp;type=3#WrestlerProfile"/>
    <Style src="project://database/Assets/Game/Presentation/Resources/PWManagerUI/Dashboard.uss?fileID=7433441132597879392&amp;guid=a1df28c29473e28419939810bd3da8c2&amp;type=3#Dashboard"/>
    <Style src="project://database/Assets/Game/Presentation/Resources/PWManagerUI/WrestlerProfile.uss?fileID=7433441132597879392&amp;guid=dee1fd46bff057449ab3a4ffcaa78f0a&amp;type=3#WrestlerProfile"/>
    <Style src="project://database/Assets/Game/Presentation/Resources/PWManagerUI/PWManagerTheme.uss?fileID=7433441132597879392&amp;guid=b725eb90bca57e6419feb728bb92cca2&amp;type=3#PWManagerTheme"/>
    <ui:VisualElement name="dashboard" class="dashboard">
        <ui:VisualElement class="sidebar">
            <ui:VisualElement class="brand">
                <ui:Label name="promotion-abbreviation" text="—" class="brand-title" style="margin-top: 1px;"/>
                <ui:Label text="PROMOTION OFFICE" class="brand-subtitle"/>
            </ui:VisualElement>
            <ui:Button name="nav-home" class="nav active"><ui:VisualElement name="icon-home" class="nav-icon"/><ui:Label text="홈" class="nav-label"/><ui:Label name="home-badge" text="0" class="badge"/></ui:Button>
            <ui:Button name="nav-message" class="nav"><ui:VisualElement name="icon-message" class="nav-icon"/><ui:Label text="메시지" class="nav-label"/><ui:Label name="message-badge" text="0" class="badge"/></ui:Button>
            <ui:VisualElement class="divider"/>
            <ui:Button name="nav-roster" class="nav"><ui:VisualElement name="icon-roster" class="nav-icon"/><ui:Label text="로스터" class="nav-label"/></ui:Button>
            <ui:Button name="nav-teams" class="nav"><ui:VisualElement name="icon-teams" class="nav-icon"/><ui:Label text="태그팀·스테이블" class="nav-label"/></ui:Button>
            <ui:Button name="nav-locker" class="nav"><ui:VisualElement name="icon-locker" class="nav-icon"/><ui:Label text="라커룸" class="nav-label"/></ui:Button>
            <ui:Button name="nav-scout" class="nav"><ui:VisualElement name="icon-scout" class="nav-icon"/><ui:Label text="스카우팅" class="nav-label"/></ui:Button>
            <ui:VisualElement class="divider"/>
            <ui:Button name="nav-show" class="nav"><ui:VisualElement name="icon-show" class="nav-icon"/><ui:Label text="쇼" class="nav-label"/><ui:Label name="show-badge" text="0" class="badge"/></ui:Button>
            <ui:Button name="nav-story" class="nav"><ui:VisualElement name="icon-story" class="nav-icon"/><ui:Label text="스토리라인" class="nav-label"/></ui:Button>
            <ui:Button name="nav-title" class="nav"><ui:VisualElement name="icon-title" class="nav-icon"/><ui:Label text="챔피언십" class="nav-label"/></ui:Button>
            <ui:Button name="nav-tournament" class="nav"><ui:VisualElement name="icon-tournament" class="nav-icon"/><ui:Label text="토너먼트" class="nav-label"/></ui:Button>
            <ui:VisualElement class="divider"/>
            <ui:Button name="nav-schedule" class="nav"><ui:VisualElement name="icon-schedule" class="nav-icon"/><ui:Label text="일정" class="nav-label"/></ui:Button>
            <ui:Button name="nav-staff" class="nav"><ui:VisualElement name="icon-staff" class="nav-icon"/><ui:Label text="시설·스태프" class="nav-label"/></ui:Button>
            <ui:Button name="nav-company" class="nav"><ui:VisualElement name="icon-company" class="nav-icon"/><ui:Label text="단체 정보" class="nav-label"/></ui:Button>
            <ui:Button name="nav-finance" class="nav"><ui:VisualElement name="icon-finance" class="nav-icon"/><ui:Label text="재정" class="nav-label"/></ui:Button>
            <ui:VisualElement class="divider"/>
            <ui:Button name="nav-report" class="nav"><ui:VisualElement name="icon-report" class="nav-icon"/><ui:Label text="리포트" class="nav-label"/><ui:Label name="report-badge" text="0" class="badge"/></ui:Button>
            <ui:Button name="nav-world" class="nav"><ui:VisualElement name="icon-world" class="nav-icon"/><ui:Label text="월드" class="nav-label"/></ui:Button>
            <ui:Button name="nav-history" class="nav"><ui:VisualElement name="icon-history" class="nav-icon"/><ui:Label text="기록" class="nav-label"/></ui:Button>
            <ui:VisualElement class="sidebar-spacer"/>
            <ui:Button name="nav-settings" class="nav"><ui:VisualElement name="icon-settings" class="nav-icon"/><ui:Label text="설정" class="nav-label"/></ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="dashboard-workspace" class="workspace">
            <ui:VisualElement class="topbar">
                <ui:VisualElement class="top-navigation"><ui:Button name="dashboard-back" text="‹" class="top-navigation-button"/><ui:Button name="dashboard-forward" text="›" class="top-navigation-button"/><ui:Label name="dashboard-page-title" text="홈 / 개요" class="top-page-title" style="margin-left: 10px; padding-left: 4px;"/></ui:VisualElement>
                <ui:VisualElement class="topbar-spacer"/>
                <ui:VisualElement class="top-stat"><ui:Label text="현재 날짜" class="eyebrow" style="margin-top: 2px; padding-top: 2px; padding-bottom: 2px;"/><ui:Label name="current-date" text="—" class="top-value"/></ui:VisualElement>
                <ui:VisualElement class="top-stat"><ui:Label text="현재 자금" class="eyebrow" style="padding-top: 2px; padding-bottom: 2px; margin-top: 2px;"/><ui:Label name="top-cash" text="—" class="top-value"/></ui:VisualElement>
                <ui:VisualElement class="top-stat wide"><ui:Label name="next-show-caption" text="다음 쇼 일정" class="eyebrow" style="padding-top: 2px; padding-bottom: 2px; margin-top: 2px;"/><ui:Label name="top-next-show" text="—" class="top-value"/></ui:VisualElement>
                <ui:Button name="notifications" text="알림  0" class="small-button"/>
                <ui:Button name="advance-time" text="시간 진행  ›" class="primary-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="wrestler-profile-content" class="dashboard-profile-content hidden" style="display: none;"><ui:Instance template="WrestlerProfileTemplate" class="dashboard-profile-template"/></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dashboard-save-load-overlay" class="save-load-overlay hidden">
            <ui:VisualElement class="save-load-dialog">
                <ui:VisualElement class="save-load-heading"><ui:VisualElement><ui:Label text="저장 / 불러오기" class="save-load-title"/><ui:Label text="수동 저장을 만들거나 기존 게임을 불러옵니다" class="save-load-copy"/></ui:VisualElement><ui:Button name="dashboard-save-load-close" text="×" class="save-load-close"/></ui:VisualElement>
                <ui:VisualElement class="manual-save-row"><ui:TextField name="manual-save-name" value="manual_save" class="manual-save-input"/><ui:Button name="manual-save-submit" text="수동 저장" class="manual-save-button"/></ui:VisualElement>
                <ui:Label name="save-load-message" text="" class="save-load-message"/>
                <ui:ScrollView mode="Vertical" class="save-load-scroll"><ui:VisualElement name="dashboard-save-load-rows" class="save-load-rows"/></ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
