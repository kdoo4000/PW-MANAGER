.group-portrait { height:220px; min-width:0; flex-shrink:0; overflow:hidden; }
.group-portrait-member { position:absolute; border-width:0; border-radius:0; padding:0; margin:0; background-color:transparent; }
.group-portrait-member:hover { background-color:transparent; }
.group-portrait-member:focus { border-width:1px; border-color:#d9b45b; }
.group-portrait-member .wrestler-portrait-frame { width:100%; height:100%; padding:0; margin:0; border-width:0; background-color:transparent; }
.group-portrait-member .wrestler-portrait-image { width:100%; height:100%; }
.group-portrait-member .wrestler-portrait-name { display:none; }
.group-portrait-thumbnail { width:92px; height:64px; flex-shrink:0; margin:0 12px 0 0; }
.group-portrait-detail { height:280px; margin:12px 0; background-color:#24262c; }
.group-portrait-picker { height:112px; }
.story-poster-group-portrait { width:100%; height:230px; }
