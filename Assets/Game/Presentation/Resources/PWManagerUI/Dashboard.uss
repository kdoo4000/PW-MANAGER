.show-detail-duration-value { min-width: 58px; margin: 0 8px; color: #d6e1ef; -unity-text-align: middle-center; }
.show-detail-duration-buttons { flex-shrink: 0; }
.show-duration-step { width: 32px; height: 20px; margin: 1px 0; padding: 0; border-width: 1px; border-color: #263a54; border-radius: 3px; background-color: #111a27; color: #a9c8e7; font-size: 10px; }
.show-duration-step:hover { background-color: #17314a; }
.show-duration-step:disabled { opacity: 0.35; }
.show-detail-actions { height: 36px; margin-top: 12px; flex-direction: row; justify-content: flex-end; }
.show-detail-action { width: 64px; height: 30px; margin: 0 0 0 7px; padding: 0; border-width: 1px; border-color: #263a54; border-radius: 6px; background-color: #111a27; color: #a9b8cb; font-size: 12px; }
.show-detail-action.edit { width: 82px; border-color: #2d6592; background-color: #123354; color: #86caff; }
.show-detail-action.danger { border-color: #62313b; background-color: #2c171d; color: #ef8b94; }
.show-duration-row { height: 24px; margin-top: 3px; flex-direction: row; justify-content: space-between; align-items: center; }
.show-duration-value { color: #e5eef9; font-size: 14px; -unity-font-style: bold; }
.show-duration-track { height: 7px; margin: 8px 0 8px; border-radius: 4px; overflow: hidden; background-color: #192231; }
.show-duration-fill { width: 0%; height: 8px; border-radius: 4px; background-color: #318de0; }
.show-duration-fill.over { background-color: #e15761; }
.show-summary-grid { height: 48px; flex-direction: row; }
