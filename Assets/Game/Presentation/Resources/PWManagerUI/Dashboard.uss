.show-detail-rule { height: 1px; flex-shrink: 0; margin: 15px 0; background-color: #1c293b; }
.show-detail-section-label { margin-bottom: 8px; color: #8798ad; font-size: 13px; -unity-font-style: bold; }
.show-participant-list { min-height: 92px; flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.show-participant-list.matchup { width: 100%; flex-grow: 1; min-height: 190px; flex-wrap: nowrap; align-items: stretch; margin-top: 8px; padding: 0; overflow: hidden; border-width: 2px; border-color: #315b82; border-radius: 2px; background-color: #111e2c; }
.show-match-side { position: relative; flex-grow: 1; flex-basis: 0; min-width: 82px; flex-direction: row; flex-wrap: nowrap; align-items: stretch; margin-right: -32px; }
