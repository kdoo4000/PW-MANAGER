.show-panel-title { flex-grow: 1; color: #e2ecf8; font-size: 15px; -unity-font-style: bold; }
.show-panel-caption { color: #73849b; font-size: 13px; }
.show-timeline-scroll { display: flex; flex-grow: 1; min-height: 0; }
.show-timeline-rows { width: 100%; }
.show-timeline-heading { height: 34px; flex-shrink: 0; flex-direction: row; align-items: flex-start; justify-content: space-between; padding: 0 4px; }
