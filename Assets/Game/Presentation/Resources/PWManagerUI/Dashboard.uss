.wrestler-portrait-name { width: 112px; margin-top: 9px; overflow: hidden; color: #bcd8ef; font-size: 14px; -unity-font-style: bold; -unity-text-align: upper-center; white-space: nowrap; text-overflow: ellipsis; }
.show-participant-list.duel .wrestler-portrait-name { width: 190px; font-size: 14px; }
