.show-portrait-trapezoid.empty { background-color: transparent; }
.show-participant-empty-label { width: 100%; height: 100%; color: #58718b; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; }
.wrestler-portrait-frame { width: 88px; height: 88px; flex-shrink: 0; align-items: center; justify-content: center; overflow: hidden; border-width: 2px; border-color: #315b82; border-radius: 44px; background-color: #14283d; }
