.show-editor-message { height: 34px; color: #ef8b94; font-size: 14px; -unity-text-align: middle-left; }
.show-editor-footer { height: 56px; flex-direction: row; justify-content: flex-end; align-items: flex-end; }
.show-editor-cancel, .show-editor-submit { width: 110px; height: 42px; margin: 0 0 0 10px; padding: 0; border-width: 1px; border-radius: 7px; font-size: 14px; -unity-font-style: bold; }
.show-editor-cancel { border-color: #2a394c; background-color: #111925; color: #9eacbd; }
.show-editor-submit { border-color: #3677ad; background-color: #1769aa; color: #eef7ff; }
.show-simulation { max-height: 220px; margin-top: 10px; padding: 10px; overflow: hidden; border-radius: 6px; background-color: #0b121c; color: #cdd8e7; font-size: 12px; white-space: normal; }
.nav-icon-home { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/home.svg"); }
.nav-icon-message { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/message.svg"); }
.nav-icon-roster { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/roster.svg"); }
.nav-icon-teams { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/teams.svg"); }
.nav-icon-locker { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/locker.svg"); }
.nav-icon-scout { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/scout.svg"); }
.nav-icon-show { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/show.svg"); }
.nav-icon-story { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/story.svg"); }
.nav-icon-title { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/title.svg"); }
.nav-icon-tournament { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/tournament.svg"); }
.nav-icon-schedule { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/schedule.svg"); }
.nav-icon-staff { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/staff.svg"); }
.nav-icon-company { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/company.svg"); }
.nav-icon-finance { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/finance.svg"); }
.nav-icon-report { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/report.svg"); }
.nav-icon-world { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/world.svg"); }
.nav-icon-history { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/history.svg"); }
.nav-icon-settings { background-image: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/VectorIcons/settings.svg"); }
.save-load-overlay { position:absolute; left:0; right:0; top:0; bottom:0; align-items:center; justify-content:center; background-color:rgba(2,5,10,0.88); }
.save-load-dialog { width:620px; height:650px; padding:24px; border-width:1px; border-color:#2c4664; border-radius:12px; background-color:#0b111a; }
.save-load-heading { height:72px; flex-direction:row; justify-content:space-between; }
.save-load-title { color:#eff6ff; font-size:22px; -unity-font-style:bold; }
.save-load-copy { margin-top:6px; color:#7e8fa5; font-size: 14px; }
.save-load-close { width:36px; height:36px; margin:0; padding:0; border-width:1px; border-color:#2b3a4d; border-radius:7px; background-color:#111925; color:#9fafc2; font-size:20px; }
.manual-save-row { height:52px; flex-direction:row; margin-top:10px; }
.manual-save-input { flex-grow:1; margin-right:10px; color:#dce7f5; }
.manual-save-input .unity-base-text-field__input { height:40px; padding:0 12px; border-width:1px; border-color:#26384f; border-radius:7px; background-color:#111925; }
.manual-save-button { width:110px; height:40px; margin:0; border-width:1px; border-color:#3677ad; border-radius:7px; background-color:#1769aa; color:#eef7ff; -unity-font-style:bold; }
.save-load-message { height:28px; color:#68d5a2; font-size: 13px; }
.save-load-message.error { color:#ef8b94; }
.save-load-scroll { flex-grow:1; min-height:0; margin-top:8px; }
.save-load-rows { width:100%; }
.save-load-row { width:100%; height:62px; margin:0 0 8px; padding:0 14px; flex-direction:row; align-items:center; border-width:1px; border-color:#26384f; border-radius:7px; background-color:#101925; }
.save-load-row:hover { border-color:#4186bd; background-color:#14283c; }
.save-load-row-copy { flex-grow:1; }
.save-load-row-name { color:#e5eef9; font-size:14px; -unity-font-style:bold; -unity-text-align:middle-left; }
.save-load-row-date { margin-top:3px; color:#74869d; font-size: 12px; -unity-text-align:middle-left; }
.save-load-row-action { width:82px; color:#75bfff; font-size: 13px; -unity-font-style:bold; -unity-text-align:middle-right; }
.save-load-empty { margin-top:70px; color:#74869d; font-size: 14px; -unity-text-align:middle-center; }
