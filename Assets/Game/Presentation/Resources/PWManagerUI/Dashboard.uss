.show-editor-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2, 5, 10, 0.88); }
.show-editor-dialog { width: 1120px; height: 850px; padding: 28px; border-width: 1px; border-color: #2c4664; border-radius: 12px; background-color: #0b111a; }
.show-editor-heading { height: 58px; flex-direction: row; justify-content: space-between; align-items: center; }
.show-editor-title { color: #eff6ff; font-size: 24px; -unity-font-style: bold; }
.show-editor-close { width: 40px; height: 40px; margin: 0; padding: 0; border-width: 1px; border-color: #2b3a4d; border-radius: 7px; background-color: #111925; color: #afbdcd; font-size: 23px; }
.show-editor-fields { height: 94px; flex-direction: row; margin-top: 12px; }
.show-editor-match-rules { flex-grow: 1; min-height: 0; flex-direction: row; margin-top: 14px; }
.show-editor-rule-column { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 20px; border-width: 1px; border-color: #26384f; border-radius: 8px; background-color: #0e1622; }
.show-editor-rule-title { color: #e5eef9; font-size: 19px; -unity-font-style: bold; }
.show-editor-rule-scroll { flex-grow: 1; min-height: 0; margin-top: 18px; }
.show-editor-rule-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.show-editor-rule-scroll .unity-scroll-view__content-container { min-width: 0; width: auto; }
.show-editor-rule-options { width: auto; min-width: 0; align-self: stretch; }
.show-editor-rule-option { width: auto; align-self: stretch; min-height: 52px; margin-bottom: 11px; padding: 0 16px; border-width: 1px; border-color: #29425d; border-radius: 6px; background-color: #132233; color: #c5d3e2; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-left; }
.show-editor-rule-option:hover { border-color: #4186bd; background-color: #17314a; color: #e5f2ff; }
.show-editor-rule-option.selected { border-color: #4aa7eb; background-color: #174d75; color: #ffffff; }
.show-editor-rule-option:disabled { border-color: #202d3d; background-color: #0d141e; color: #4f5d6f; }
.show-editor-rule-divider { width: 82px; flex-shrink: 0; align-items: center; justify-content: center; }
.show-editor-rule-arrow { color: #4a98d2; font-size: 40px; -unity-font-style: bold; }
.show-editor-rule-empty { margin-top: 8px; color: #8495aa; font-size: 14px; }
.show-editor-spots { flex-grow: 1; min-height: 0; margin-top: 10px; }
.spot-production-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.show-editor-dialog.spot-production { width: 94%; height: 94%; max-width: 1440px; max-height: 1000px; }
.spot-production .show-editor-spot-field .unity-base-text-field__input { min-height: 50px; }
.spot-heading > Label { -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf"); }
.spot-authored-events { flex-grow: 1; flex-basis: 0; min-width: 0; }
.spot-catalog { flex-grow: 1.6; flex-basis: 0; min-width: 0; margin-left: 20px; }
.spot-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; color: #dce7f5; font-size: 17px; -unity-font-style: bold; }
.spot-list { flex-grow: 1; min-height: 0; }
.spot-row { flex-shrink: 0; padding: 12px; margin-bottom: 12px; border-width: 1px; border-color: #26384f; border-radius: 7px; background-color: #111925; }
.spot-row .show-editor-field { margin-right: 6px; margin-bottom: 10px; min-width: 0; }
.spot-row > .show-editor-field { flex-grow: 0; flex-shrink: 0; }
.spot-roles .show-editor-field { flex-basis: 0; }
.spot-preview { flex-shrink: 0; color: #cdd8e7; font-size: 14px; white-space: normal; margin-bottom: 14px; }
.spot-row .unity-popup-field__input { min-height: 28px; }
.spot-roles { flex-direction: row; }
.spot-info, .spot-empty { color: #94a3b7; font-size: 13px; white-space: normal; margin-bottom: 8px; }
.spot-warning { color: #e3b36c; font-size: 13px; white-space: normal; margin-bottom: 8px; }
.spot-row > .small-button { align-self: flex-end; }
.show-editor-finish { flex-direction: row; flex-shrink: 0; min-height: 94px; margin-bottom: 12px; }
.show-editor-finish .show-editor-field { flex-basis: 0; min-width: 0; }
.show-editor-spot-field { flex-grow: 1; flex-direction: column; margin-bottom: 14px; color: #cdd8e7; font-size: 14px; }
.show-editor-spot-field .unity-base-field__label { width: 100%; margin-bottom: 7px; color: #94a3b7; font-size: 14px; }
.show-editor-spot-field .unity-base-text-field__input { flex-grow: 1; min-height: 100px; padding: 12px; border-width: 1px; border-color: #26384f; border-radius: 7px; background-color: #111925; color: #dce7f5; font-size: 14px; white-space: normal; }
.show-editor-field { flex-grow: 1; margin-right: 18px; flex-direction: column; color: #cdd8e7; font-size: 14px; }
.show-editor-field.duration { width: 180px; flex-grow: 0; margin-right: 0; }
.show-editor-field .unity-base-field__label { width: 100%; color: #94a3b7; font-size: 14px; }
.show-editor-field .unity-base-field__input { width: 100%; height: 42px; margin-top: 8px; padding: 0 12px; border-width: 1px; border-color: #26384f; border-radius: 7px; background-color: #111925; font-size: 14px; }
.show-editor-roster-heading { height: 52px; margin-top: 18px; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: #1d2a3b; }
.show-editor-roster-sort { min-width: 230px; margin-left: 20px; color: #cdd8e7; }
.show-editor-roster-sort .unity-base-field__label { min-width: 40px; }
.show-editor-roster-sort .unity-base-field__input { min-height: 34px; padding: 0 10px; border-width: 1px; border-color: #26384f; border-radius: 7px; background-color: #111925; }
.show-editor-section-title { color: #dce7f5; font-size: 16px; -unity-font-style: bold; }
.show-editor-selected-count { color: #62b3f4; font-size: 14px; -unity-font-style: bold; }
.show-editor-roster-scroll { flex-grow: 1; min-height: 0; margin-top: 14px; }
.show-timeline-scroll .unity-scroll-view__horizontal-scroller,
.show-editor-roster-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.show-timeline-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger,
.show-editor-dialog .unity-scroll-view__vertical-scroller .unity-base-slider__dragger { width: 7px; min-width: 7px; }
.show-editor-roster { flex-direction: row; flex-wrap: wrap; }
.show-editor-wrestler { width: 32%; height: 142px; margin: 0 1.3% 14px 0; padding: 13px 14px; flex-direction: row; align-items: center; border-width: 1px; border-color: #223248; border-radius: 8px; background-color: #101722; color: #aebdd0; }
.show-editor-wrestler:hover { border-color: #365574; background-color: #131e2c; }
.show-editor-wrestler.selected { border-color: #3b9cff; background-color: #123050; }
.show-editor-wrestler:disabled { opacity: 0.35; border-color: #223248; background-color: #101722; }
.show-editor-wrestler-portrait { width: 76px; height: 76px; flex-shrink: 0; align-items: center; justify-content: center; overflow: hidden; border-width: 2px; border-color: #315b82; border-radius: 38px; background-color: #14283d; }
.show-editor-wrestler.selected .show-editor-wrestler-portrait { border-color: #65b9ff; }
.show-editor-wrestler-image { width: 100%; height: 100%; }
.show-editor-wrestler-initials { color: #8dccff; font-size: 23px; -unity-font-style: bold; -unity-text-align: middle-center; }
.show-editor-wrestler-info { flex-grow: 1; min-width: 0; margin-left: 14px; align-items: flex-start; }
.show-editor-wrestler-line { width: 100%; min-height: 27px; flex-direction: row; align-items: center; justify-content: flex-start; color: #a5b3c5; }
