.wrestler-link.show-editor-wrestler-name { flex-grow: 1; height: 27px; margin: 0; padding: 0; overflow: hidden; border-width: 0; background-color: transparent; color: #60a5fa; font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-left; white-space: nowrap; text-overflow: ellipsis; }
.wrestler-link.show-editor-wrestler-name:hover { color: #93c5fd; }
.show-editor-wrestler-identity { margin-top: 2px; }
.show-editor-wrestler-tag { min-width: 46px; height: 23px; margin-right: 7px; padding: 0 7px; border-radius: 4px; background-color: #192638; color: #9bcdf5; -unity-text-align: middle-center; }
