:root { color: #dbe5f2; font-size: 14px; }
.dashboard { flex-direction: row; width: 100%; height: 100%; background-color: #05070b; overflow: hidden; }
.sidebar { width: 224px; min-width: 224px; height: 100%; padding: 18px 16px 20px; background-color: #0b111b; border-right-width: 1px; border-right-color: #18243a; }
.brand { height: 70px; min-height: 70px; flex-shrink: 0; padding-left: 12px; justify-content: flex-start; }
.brand-title { color: #ebf5ff; font-size: 18px; -unity-font-style: bold; }
.brand-subtitle { color: #4fb0ff; font-size: 12px; -unity-font-style: bold; margin-top: 1px; }
.nav { height: 38px; min-height: 38px; margin-bottom: 4px; padding: 0 10px 0 12px; border-width: 0; border-radius: 8px; background-color: #0c1018; flex-direction: row; align-items: center; }
.nav-icon { width: 14px; height: 14px; min-width: 14px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.nav-label { flex-grow: 1; color: #c8d5e7; font-size: 14px; -unity-text-align: middle-left; }
.badge { min-width: 20px; height: 19px; padding: 1px 6px; border-radius: 10px; background-color: #73292e; color: #ffcccc; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; }
.nav:hover { background-color: #142238; color: #ffffff; }
.nav:hover .nav-label { color: #ffffff; }
.nav.active { background-color: #0e4b8d; }
.nav.active .nav-label { color: #e5f2ff; -unity-font-style: bold; }
.divider { height: 1px; margin: 7px 12px 8px; background-color: #232832; }
.sidebar-spacer, .topbar-spacer, .grow { flex-grow: 1; }
.workspace { flex-grow: 1; height: 100%; min-width: 0; }
.topbar { height: 58px; min-height: 58px; flex-direction: row; align-items: center; padding: 0 24px; background-color: #08101b; border-bottom-width: 1px; border-bottom-color: #182235; }
.top-navigation { flex-direction: row; align-items: center; flex-shrink: 0; }
.top-navigation-button { width: 34px; min-width: 34px; height: 34px; min-height: 34px; margin: 0 8px 0 0; padding: 0; border-width: 1px; border-color: #26364d; border-radius: 7px; background-color: #101827; color: #b7c5d8; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; }
.top-navigation-button:hover { background-color: #17243a; color: #ffffff; border-color: #3f5e82; }
.top-page-title { margin-left: 4px; color: #e5edf8; font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-left; white-space: nowrap; }
.top-stat { min-width: 100px; margin-left: 22px; }
.top-stat.wide { min-width: 145px; }
.eyebrow { color: #6f7f95; font-size: 12px; -unity-font-style: bold; }
.top-value { color: #dce7f5; font-size: 14px; -unity-font-style: bold; margin-top: 2px; }
.small-button, .primary-button { height: 34px; margin-left: 12px; border-width: 0; border-radius: 7px; color: #dce9f8; font-size: 14px; -unity-font-style: bold; }
.small-button { width: 72px; min-width: 72px; height: 34px; min-height: 34px; padding: 0; margin-top: 0; margin-bottom: 0; align-self: center; justify-content: center; align-items: center; background-color: #141a25; -unity-text-align: middle-center; }
.primary-button { width: 100px; min-width: 100px; height: 34px; min-height: 34px; padding: 0; margin-top: 0; margin-bottom: 0; align-self: center; justify-content: center; align-items: center; background-color: #1377cf; -unity-text-align: middle-center; }
.content { flex-grow: 1; min-height: 0; padding: 16px 24px 18px; overflow: hidden; }
.tabs { height: 38px; min-height: 38px; flex-direction: row; align-items: flex-start; }
.tab { width: 112px; min-width: 112px; height: 36px; min-height: 36px; margin: 0 8px 0 0; padding: 0; border-width: 0; border-radius: 7px; background-color: transparent; color: #8795a9; font-size: 14px; align-self: flex-start; justify-content: center; align-items: center; -unity-text-align: middle-center; }
.tab.active-tab { background-color: #0d315d; color: #cfeaff; -unity-font-style: bold; border-bottom-width: 2px; border-bottom-color: #3a9fff; }
.row { flex-direction: row; }
.upper-row { height: 408px; min-height: 408px; margin-bottom: 14px; }
.lower-row { flex-grow: 1; min-height: 0; }
.card { padding: 16px 18px; border-width: 1px; border-color: #1e304b; border-radius: 12px; background-color: #0c111a; }
.schedule-card, .operations-card { margin-right: 14px; }
.schedule-card { min-width: 0; }
.priority-card, .result-card { width: 37.5%; min-width: 380px; max-width: 618px; }
.priority-card { border-color: #44242d; }
.section-heading, .progress-heading { flex-direction: row; justify-content: space-between; align-items: center; }
.card-title { color: #e5edfa; font-size: 16px; -unity-font-style: bold; margin-bottom: 10px; }
.link, .task-link { color: #4baaff; font-size: 12px; -unity-font-style: bold; }
.event-strip { height: 88px; flex-direction: row; align-items: center; padding: 8px 10px; border-radius: 8px; background-color: #121a29; }
.date-tile { width: 52px; height: 62px; padding-top: 9px; margin-right: 14px; border-radius: 8px; background-color: #1765ac; color: #ecf6ff; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.event-copy { justify-content: center; }
.event-title, .result-title { color: #f2f7ff; font-size: 17px; -unity-font-style: bold; }
.muted { color: #7d8fa6; font-size: 13px; margin-top: 2px; }
.chips { flex-direction: row; margin-top: 5px; }
.chip { padding: 3px 8px; margin-right: 7px; border-radius: 9px; background-color: #1a202b; color: #a6b3c5; font-size: 12px; }
.chip.blue { background-color: #123951; color: #52bcf3; }.chip.amber { background-color: #382b16; color: #f1ad45; }
.progress-heading { margin-top: 9px; }.progress { height: 7px; margin-top: 4px; border-radius: 4px; background-color: #1b2330; }.progress-fill { width: 70%; height: 7px; border-radius: 4px; background-color: #3ca6f3; }
.task { height: 60px; margin-bottom: 6px; padding: 6px 10px; border-radius: 7px; background-color: #111722; flex-direction: row; align-items: center; }
.task.danger { background-color: #29151a; }.task-type { width: 48px; font-size: 12px; -unity-font-style: bold; }.task-text { flex-grow: 1; color: #d4deeb; font-size: 13px; }.task-link { width: 100px; -unity-text-align: middle-right; }
.red { color: #ff7279; }.amber-text { color: #e6a64a; }.blue-text { color: #4fafff; }.green { color: #66d4a6; }.hot { color: #ffa65c; }
.metrics { height: 88px; min-height: 88px; flex-direction: row; }.metric { flex-grow: 1; margin-right: 7px; padding: 7px 12px; border-radius: 7px; background-color: #111722; }.metric-value { color: #e5edf8; font-size: 18px; -unity-font-style: bold; margin-top: 1px; }.micro { color: #77879d; font-size: 12px; margin-top: 2px; }
.operations-grid { flex-grow: 1; min-height: 0; flex-direction: row; margin-top: 8px; }.inner-card { border-radius: 8px; background-color: #11151e; }.fan-card, .stories { width: 50%; padding: 12px; }.fan-card { margin-right: 10px; }.inner-heading { flex-direction: row; justify-content: space-between; }.inner-title { color: #9faec1; font-size: 13px; -unity-font-style: bold; margin-bottom: 6px; }.fan-bar { height: 10px; flex-direction: row; margin: 5px 0 8px; border-radius: 5px; overflow: hidden; background-color: #1a202b; }.fan { height: 10px; }.fan.mania { width: 33.34%; background-color: #4fafff; }.fan.light { width: 33.33%; background-color: #a86ff5; }.fan.family { width: 33.33%; background-color: #54cfa0; }.fan-row { height: 27px; flex-direction: row; align-items: center; font-size: 12px; }.fan-name { flex-grow: 1; }.fan-percent { width: 42px; color: #dee5f2; -unity-text-align: middle-right; }.fan-note { width: 66px; color: #69798f; -unity-text-align: middle-right; }.mania-text { color: #4fafff; }.light-text { color: #a86ff5; }.family-text { color: #54cfa0; }
.story { height: 58px; padding: 8px 10px; margin-bottom: 6px; border-radius: 7px; background-color: #131822; }.story-title { color: #dbe5f2; font-size: 12px; -unity-font-style: bold; }
.result-title { margin-bottom: 1px; }.result-metrics { height: 82px; flex-direction: row; margin: 10px 0; }.result-metric { width: 50%; padding: 7px 12px; }.result-metric-leading { margin-right: 10px; }.stars { color: #f2c14e; font-size: 16px; -unity-font-style: bold; margin-top: 2px; }.rating { height: 26px; flex-direction: row; justify-content: space-between; align-items: center; font-size: 13px; }.change { margin-top: 6px; padding: 8px 12px; border-radius: 8px; background-color: #131822; }.change-text { color: #d1dbeb; font-size: 13px; margin-top: 3px; }
.wrestler-link { height: 28px; padding: 0 4px; color: rgb(96, 165, 250); background-color: transparent; border-width: 0; -unity-font-style: bold; -unity-text-align: middle-left; }
.wrestler-link:hover { color: rgb(147, 197, 253); }
.hidden { display: none; }
.roster-content { flex-grow: 1; min-height: 0; padding: 0 24px 18px; background-color: #05070b; }
.message-content { flex-grow: 1; min-height: 0; flex-direction: row; padding: 18px 24px 22px; background-color: #05070b; }
.message-list-pane { width: 35%; min-width: 310px; max-width: 450px; margin-right: 14px; overflow: hidden; border-width: 1px; border-color: #202c3d; border-radius: 8px; background-color: #0c111a; }
.message-toolbar { height: 58px; flex-shrink: 0; padding: 0 16px; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: #202c3d; }
.message-heading { color: #edf5ff; font-size: 18px; -unity-font-style: bold; }
.message-count { color: #71839a; font-size: 13px; }
.message-list-scroll { flex-grow: 1; min-height: 0; }
.message-list-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.message-list { width: 100%; }
.message-date-group { height: 36px; padding: 0 14px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: #26364a; background-color: #111a27; }
.message-date-label { color: #91a3b8; font-size: 12px; -unity-font-style: bold; }
.message-row { width: 100%; height: 68px; margin: 0; padding: 11px 14px; flex-direction: column; align-items: stretch; border-width: 0 0 1px 3px; border-color: transparent transparent #182435 transparent; border-radius: 0; background-color: #0c111a; }
.message-row:hover { background-color: #111c2b; }
.message-row.unread { background-color: #172b40; }
.message-row.unread:hover { background-color: #1d354d; }
.message-row.selected { border-left-color: #4fafff; background-color: #11263c; }
.message-row.unread.selected { background-color: #204361; }
.message-row.required { border-left-color: #e15761; }
.message-row.important .message-subject { color: #f1c453; }
.message-row-top { height: 20px; flex-direction: row; align-items: center; justify-content: space-between; }
.message-sender { flex-grow: 1; min-width: 0; color: #aab9cb; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-left; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.message-row.unread .message-sender { color: #72baff; }
.message-subject { height: 23px; margin-top: 4px; color: #e0e9f5; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-left; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.message-detail-pane { flex-grow: 1; min-width: 0; padding: 28px 32px; border-width: 1px; border-color: #202c3d; border-radius: 8px; background-color: #0c111a; }
.message-detail-empty { flex-grow: 1; align-items: center; justify-content: center; }
.message-empty-title { color: #687b92; font-size: 15px; }
.message-detail { flex-grow: 1; min-height: 0; }
.message-detail-header { height: 30px; flex-direction: row; align-items: center; justify-content: space-between; }
.message-detail-sender { color: #69b7f5; font-size: 14px; -unity-font-style: bold; }
.message-detail-time { color: #687a91; font-size: 12px; }
.message-detail-subject { margin-top: 14px; color: #f0f6ff; font-size: 24px; -unity-font-style: bold; white-space: normal; }
.message-detail-rule { height: 1px; margin: 22px 0; background-color: #202c3d; }
.message-detail-body { color: #b4c2d3; font-size: 15px; white-space: normal; }
.message-detail-spacer { flex-grow: 1; }
.message-open-target { width: 150px; height: 38px; align-self: flex-end; margin: 16px 0 0; border-width: 1px; border-color: #3677ad; border-radius: 7px; background-color: #1769aa; color: #eef7ff; -unity-font-style: bold; }
.roster-tabs { height: 72px; min-height: 72px; flex-direction: row; align-items: center; }
.roster-tab { width: 116px; height: 44px; margin: 0 8px 0 0; padding: 0; border-width: 0; border-radius: 7px; background-color: transparent; color: #748197; font-size: 14px; -unity-font-style: bold; }
.roster-tab.roster-tab-all { width: 88px; }
.roster-tab:hover { color: #b8c4d9; background-color: #101722; }
.roster-tab.roster-tab-active { color: #4dabff; background-color: #131f33; border-bottom-width: 2px; border-bottom-color: #4dabff; }
.roster-panel { flex-grow: 1; min-height: 0; padding: 20px; border-width: 1px; border-color: #1a1f2a; border-radius: 10px; background-color: #0a0d14; }
.roster-toolbar { height: 44px; min-height: 44px; flex-direction: row; align-items: center; margin-bottom: 16px; }
.roster-summary { color: #b8c4d9; font-size: 14px; -unity-font-style: bold; }
.roster-toolbar-spacer { flex-grow: 1; }
.roster-search { width: 280px; height: 34px; margin-right: 8px; color: #b8c4d9; font-size: 14px; }
.roster-search .unity-base-text-field__input { height: 34px; padding: 0 12px; border-width: 1px; border-color: #232832; border-radius: 7px; background-color: #0e121a; color: #b8c4d9; }
.roster-tool-button { width: 64px; height: 34px; margin: 0 0 0 8px; padding: 0; border-width: 1px; border-color: #263143; border-radius: 7px; background-color: #10151e; color: #9aa8bc; font-size: 13px; -unity-font-style: bold; }
.roster-columns-button { width: 76px; }
.roster-tool-button:hover { border-color: #3c516c; color: #e3ebf6; background-color: #151d29; }
.roster-table-scroll { flex-grow: 1; min-height: 0; border-width: 1px; border-color: #1a1f2a; border-radius: 8px; background-color: #0c1017; }
.roster-table-scroll .unity-scroll-view__content-container { width: 100%; }
.roster-table-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.roster-table { width: 100%; min-width: 0; align-items: stretch; }
.roster-rows { width: 100%; min-width: 0; align-items: stretch; }
.roster-table-header, .roster-row { width: auto; min-width: 0; align-self: stretch; height: 42px; min-height: 42px; flex-direction: row; }
.roster-row { height: 48px; min-height: 48px; align-items: center; background-color: #0c1017; border-bottom-width: 1px; border-bottom-color: #151b25; }
.roster-row.roster-row-alt { background-color: #0b0f15; }
.roster-row:hover { background-color: #111a27; }
.roster-header { height: 42px; min-width: 0; margin: 0; padding: 0 6px; border-width: 0; border-radius: 0; background-color: #10151e; color: #808fa8; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; flex-basis: 0; flex-shrink: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.roster-header:hover { color: #d8e4f3; background-color: #151c28; }
.roster-header.sorted { color: #4dabff; }
.roster-cell { height: 48px; min-width: 0; margin: 0; padding: 0 6px; color: #b8c4d9; font-size: 13px; -unity-text-align: middle-center; flex-basis: 0; flex-shrink: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.roster-cell-muted { color: #748197; }
.wrestler-link.roster-name-link { margin: 0; padding: 0 6px; border-width: 0; border-radius: 0; background-color: transparent; color: #60a5fa; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-left; }
.roster-header.roster-col-name { -unity-text-align: middle-left; }
.wrestler-link.roster-name-link:hover { color: #93c5fd; }
.roster-empty { height: 100px; color: #748197; font-size: 14px; -unity-text-align: middle-center; }
.roster-grade { -unity-font-style: bold; }
.grade-ss { color: #ffd166; }.grade-sp { color: #ff8a65; }.grade-s { color: #ff5c7a; }.grade-ap { color: #c084fc; }.grade-a { color: #60a5fa; }.grade-bp { color: #22d3ee; }.grade-b { color: #2dd4bf; }.grade-c { color: #84cc16; }.grade-d { color: #f59e0b; }.grade-e { color: #94a3b8; }
.role-face { color: #60a5fa; }.role-heel { color: #f87171; }.role-tweener { color: #c084fc; }
.status-main { color: #f5c451; }.status-mid { color: #b794f4; }.status-jobber { color: #7c8aa5; }.status-rookie { color: #f472b6; }
.meter-low { color: #64748b; }.meter-blue { color: #60a5fa; }.meter-cyan { color: #22d3ee; }.meter-orange { color: #fb923c; }.meter-gold { color: #f5c451; }.meter-green { color: #4ade80; }.meter-yellow { color: #facc15; }.meter-red { color: #f87171; }
.roster-col-name { flex-grow: 2.15; }.roster-col-gender { flex-grow: 0.65; }.roster-col-age { flex-grow: 0.6; }.roster-col-height { flex-grow: 0.82; }.roster-col-weight { flex-grow: 0.88; }.roster-col-role { flex-grow: 0.78; }.roster-col-style { flex-grow: 1.32; }.roster-col-match { flex-grow: 1.05; }.roster-col-promo { flex-grow: 1.05; }.roster-col-status { flex-grow: 1.2; }.roster-col-momentum { flex-grow: 1.08; }.roster-col-condition { flex-grow: 0.98; }.roster-col-satisfaction { flex-grow: 1.05; }.roster-col-team { flex-grow: 2.28; }.roster-col-salary { flex-grow: 1.64; }
.dashboard-profile-content { flex-grow: 1; min-height: 0; background-color: #05070b; }
.dashboard-profile-template { flex-grow: 1; min-height: 0; width: 100%; }
.dashboard-profile-content .wp-screen { position: relative; left: auto; right: auto; top: auto; bottom: auto; flex-grow: 1; width: 100%; height: 100%; }
.dashboard-profile-content .wp-sidebar, .dashboard-profile-content .wp-topbar { display: none; }
.dashboard-profile-content .wp-workspace { width: 100%; height: 100%; }
.show-schedule-content { flex-grow: 1; min-height: 0; padding: 18px 24px 22px; background-color: #05070b; }
.show-schedule-heading { height: 88px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 22px; margin-bottom: 14px; border-width: 1px; border-color: #1e304b; border-radius: 10px; background-color: #0c111a; }
.show-schedule-title { color: #eef6ff; font-size: 20px; -unity-font-style: bold; }
.show-schedule-caption { margin-top: 5px; color: #7f90a8; font-size: 14px; }
.show-schedule-totals { flex-direction: row; }
.show-schedule-total { min-width: 76px; height: 30px; margin-left: 8px; padding: 5px 12px; border-radius: 15px; background-color: #151e2a; color: #9cacbf; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }
.show-schedule-total.upcoming { background-color: #123354; color: #8dceff; }
.show-schedule-scroll { flex-grow: 1; min-height: 0; }
.show-schedule-rows { width: 100%; }
.show-schedule-row { height: 92px; min-height: 92px; flex-direction: row; align-items: center; margin-bottom: 10px; padding: 0 18px; border-width: 1px; border-color: #1d2b40; border-radius: 10px; background-color: #0b1018; }
.show-schedule-row:hover { border-color: #315274; background-color: #101927; }
.show-schedule-date { width: 82px; color: #68b8ff; font-size: 14px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.show-schedule-copy { flex-grow: 1; min-width: 0; margin-left: 18px; }
.show-schedule-name { color: #e5eef9; font-size: 16px; -unity-font-style: bold; }
.show-schedule-meta { margin-top: 6px; color: #73849b; font-size: 13px; }
.show-schedule-metric { width: 116px; align-items: flex-end; }
.show-schedule-metric-label { color: #65758c; font-size: 12px; -unity-font-style: bold; }
.show-schedule-metric-value { margin-top: 4px; color: #cbd8e8; font-size: 14px; -unity-font-style: bold; }
.show-schedule-status { width: 82px; height: 28px; margin-left: 16px; border-radius: 14px; background-color: #172536; color: #91a4bb; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; }
.show-schedule-status.open { background-color: #12375a; color: #7dc3ff; }
.show-schedule-open { width: 88px; height: 34px; margin-left: 16px; border-width: 1px; border-color: #28577d; border-radius: 7px; background-color: #123354; color: #8dceff; font-size: 13px; -unity-font-style: bold; }
.show-planning-content { flex-grow: 1; min-height: 0; padding: 18px 24px 22px; background-color: #05070b; }
.show-planning-header { height: 104px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 24px; margin-bottom: 14px; border-width: 1px; border-color: #1e304b; border-radius: 10px; background-color: #0c111a; }
.show-heading-copy { flex-grow: 1; min-width: 220px; }
.show-plan-name { color: #eef6ff; font-size: 20px; -unity-font-style: bold; }
.show-plan-meta { margin-top: 5px; color: #7f90a8; font-size: 14px; }
.show-header-stats { flex-direction: row; align-items: center; margin-right: 18px; }
.show-header-actions { flex-direction: row; align-items: center; }
.show-header-summary-grid { width: 238px; height: 58px; flex-shrink: 0; margin-right: 18px; }
.show-header-summary-grid .show-summary-cell { background-color: #111925; }
.show-selector { width: 100%; margin: 0 0 12px; color: #cbd8e8; font-size: 13px; }
