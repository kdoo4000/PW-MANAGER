.show-event-position-label { min-width: 68px; margin-left: 10px; color: #718198; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-right; }
.show-event-row.opening .show-event-position-label { color: #73d39a; }
.show-event-row.main-event .show-event-position-label { color: #e1bd55; }
.show-empty-state { padding-top: 90px; color: #697990; font-size: 14px; -unity-text-align: upper-center; white-space: normal; }
.show-kind-chip { min-width: 66px; height: 24px; padding: 3px 10px; border-radius: 12px; color: #7dc3ff; background-color: #12375a; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; }
.show-kind-chip.promo { color: #c7a5ff; background-color: #35224f; }
.show-detail-title { margin-top: 8px; color: #f0f6ff; font-size: 18px; -unity-font-style: bold; white-space: normal; }
.show-detail-subtitle { margin-top: 6px; color: #77889f; font-size: 13px; white-space: normal; }
