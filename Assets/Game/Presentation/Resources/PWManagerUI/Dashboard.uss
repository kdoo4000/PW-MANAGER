.show-timeline-summary { height: 62px; margin-bottom: 12px; padding: 10px 12px; border-color: #233650; background-color: #0e1622; }
.show-summary-title { color: #dce8f7; font-size: 14px; -unity-font-style: bold; }
.show-event-row { height: 72px; min-height: 72px; flex-direction: row; align-items: center; padding: 0 14px; margin-bottom: 8px; border-width: 1px; border-color: #19263a; border-radius: 8px; background-color: #101722; transition-duration: 0.12s; transition-timing-function: ease-out; }
.show-event-row:hover { border-color: #315274; background-color: #142033; }
.show-event-row.selected { border-color: #3b9cff; background-color: #102945; }
.show-event-row.opening { border-left-width: 4px; border-left-color: #73d39a; }
.show-event-row.main-event { border-left-width: 4px; border-left-color: #e1bd55; }
.show-event-row.dragging { opacity: 0.78; border-color: #68b8ff; background-color: #173252; transition-duration: 0s; }
.show-event-drag-handle { width: 24px; height: 48px; flex-shrink: 0; margin-right: 4px; color: #61728b; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; }
.show-event-drag-handle:hover { color: #68b8ff; }
.show-event-order { width: 42px; color: #61728b; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; }
.show-event-type { width: 68px; height: 25px; margin-right: 12px; border-radius: 13px; color: #7dc3ff; background-color: #12375a; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; }
.show-event-type.promo { color: #c7a5ff; background-color: #35224f; }
.show-event-copy { flex-grow: 1; min-width: 0; }
