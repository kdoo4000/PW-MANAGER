.sm-screen {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    padding: 18px 24px;
    color: var(--pw-text);
    -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Regular.ttf");
}
.sm-header { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; min-height: 44px; margin-bottom: 12px; }
.sm-title { color: var(--pw-text-strong); font-size: 24px; margin: 0 24px 0 0; -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf"); }
.sm-stories { flex-grow: 1; flex-basis: 260px; min-width: 0; margin-right: 12px; }
.sm-stories .unity-base-field__label { min-width: 72px; color: #bcb6ad; }
.sm-stories .unity-base-field__input { min-height: 42px; background-color: #1a1b1f; color: #f4f0e7; border-width: 1px; border-color: #918c84; border-radius: 3px; }
.sm-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; margin-bottom: 12px; }
.sm-relations-filter { width: 260px; min-height: 44px; margin: 0; align-items: center; color: #d9d6cf; }
.sm-relations-filter .unity-base-field__label { min-width: 44px; }
.sm-relations-filter .unity-base-field__input { min-height: 36px; background-color: #1a1b1f; color: #f4f0e7; border-width: 1px; border-color: #918c84; border-radius: 3px; }
.sm-action { min-height: 44px; min-width: 60px; padding: 6px 12px; margin: 0 0 0 6px; border-width: 1px; border-color: #918c84; border-radius: 3px; background-color: #1a1b1f; color: #f4f0e7; font-size: 14px; }
.sm-action:hover { background-color: #302a1e; }
.sm-action:focus, .sm-story-link:focus { border-color: #d9b45b; background-color: #302a1e; }
.sm-body { flex-direction: row; flex-grow: 1; min-height: 0; min-width: 0; }
.sm-canvas-host { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; background-color: #101114; border-width: 1px; border-color: #343238; overflow: hidden; }
.sm-canvas { flex-grow: 1; min-height: 0; overflow: hidden; }
.sm-canvas:focus { border-width: 1px; border-color: #d9b45b; }
.sm-detail { flex-grow: 0; flex-shrink: 0; width: 28%; min-width: 250px; max-width: 380px; margin-left: 18px; padding-left: 18px; border-left-width: 1px; border-left-color: #343238; }
.sm-detail .unity-scroll-view__horizontal-scroller { display: none; }
.sm-detail .unity-scroll-view__content-container { padding-right: 10px; }
.sm-detail-heading { color: #f4f0e7; font-size: 17px; margin: 8px 0 12px; white-space: normal; -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf"); }
.sm-copy { white-space: normal; color: #bcb6ad; font-size: 14px; margin-bottom: 12px; flex-shrink: 0; }
.sm-empty { flex-grow: 1; -unity-text-align: middle-center; color: #bcb6ad; font-size: 17px; white-space: normal; padding: 24px; }
.sm-detail-section { padding: 12px 0 4px; border-top-width: 1px; border-top-color: #343238; flex-shrink: 0; }
.sm-story-link { min-height: 44px; margin: 0 0 8px; padding: 8px 10px; background-color: #1a1b1f; color: #d9b45b; border-width: 1px; border-color: #918c84; border-radius: 3px; white-space: normal; }
.sm-story-link Label { white-space: normal; }
.sm-people { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.sm-event-direction { height: 36px; margin-right: 10px; color: #bcb6ad; -unity-text-align: middle-center; }
.sm-screen .sm-detail-link, .sm-screen .sm-detail-name { min-height: 36px; margin: 0 10px 6px 0; padding: 4px 0; border-width: 0; background-color: transparent; color: #d9b45b; white-space: normal; -unity-text-align: middle-left; }
.sm-screen .sm-detail-name { font-size: 23px; -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf"); }
.sm-screen .sm-detail-link:focus, .sm-screen .sm-detail-name:focus { background-color: #302a1e; }
.sm-faction { position: absolute; border-width: 1px; border-color: #68b8ff; border-radius: 3px; background-color: #161b22; }
.sm-faction-selected { border-color: #d9b45b; }
.sm-faction-name { position: absolute; left: 8px; right: 8px; top: 5px; height: 28px; margin: 0; color: #8bc7ff; font-size: 17px; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf"); }
.sm-independent { position: absolute; }
.sm-subteam { position: absolute; border-width: 1px; border-color: #68b8ff; border-radius: 2px; }
.sm-subteam-name { position: absolute; left: 6px; right: 6px; top: 2px; height: 24px; margin: 0; color: #8bc7ff; font-size: 14px; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sm-wrestler { position: absolute; background-color: #101114; border-width: 2px; border-color: #49454a; border-radius: 4px; overflow: hidden; }
.sm-face { border-color: #68b8ff; }
.sm-heel { border-color: #ef7b83; }
.sm-tweener { border-color: #c7a5ff; }
.sm-wrestler.sm-selected { border-width: 3px; background-color: #302a1e; }
.sm-alignment-legend { flex-direction: row; flex-wrap: wrap; align-items: center; margin-left: 18px; }
.sm-alignment-key { border-left-width: 3px; padding-left: 6px; margin: 0 12px 0 0; color: #bcb6ad; font-size: 13px; }
.sm-portrait { height: 116px; min-height: 0; padding: 0; margin: 0; border-width: 0; border-bottom-width: 1px; border-color: #49454a; border-radius: 0; background-color: #23242a; }
.sm-portrait:hover, .sm-portrait:focus { background-color: #35302a; border-color: #d9b45b; }
.sm-portrait:focus { border-width: 2px; }
.sm-portrait Image { width: 100%; height: 100%; }
.sm-portrait .wrestler-portrait-frame { width: 100%; height: 100%; border-width: 0; border-radius: 0; background-color: transparent; }
.sm-portrait .wrestler-portrait-initials { flex-grow: 1; -unity-text-align: middle-center; color: #bcb6ad; font-size: 32px; }
.sm-screen .sm-name { min-width: 0; min-height: 28px; max-height: 28px; padding: 2px 4px; margin: 0; border-width: 0; border-radius: 0; background-color: #101114; color: #f4f0e7; font-size: 14px; -unity-text-align: middle-center; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
#locker-room-board { padding: 16px; }
.locker-room-groups { flex-direction: row; flex-wrap: wrap; }
.locker-room-groups .locker-room-group { flex-basis: 328px; flex-grow: 1; margin: 0 6px 12px; }
.locker-room-group { min-width: 0; padding: 12px 12px 4px; background-color: #1a1b1f; border-width: 1px; border-color: #555047; border-radius: 3px; }
.locker-room-group .sm-detail-heading { margin-top: 0; }
#locker-room-ungrouped { margin: 0 6px; background-color: #141519; border-color: #343238; }
.locker-room-members { flex-direction: row; flex-wrap: wrap; }
#locker-room .sm-wrestler { position: relative; width: 128px; max-width: 100%; flex-shrink: 0; margin: 0 8px 8px 0; }
#locker-room .sm-wrestler.sm-selected { border-color: #d9b45b; }
#locker-room .sm-portrait { height: 104px; }
#locker-room .sm-name { min-height: 44px; max-height: 44px; height: 44px; white-space: normal; text-overflow: clip; }
.sm-screen .sm-name:hover, .sm-screen .sm-name:focus { background-color: #302a1e; color: #d9b45b; }
.sm-champion { height: 18px; margin: 0; color: #d9b45b; font-size: 11px; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sm-line-target { position: absolute; min-width: 0; min-height: 0; margin: 0; padding: 0; border-width: 0; border-radius: 14px; background-color: transparent; }
.sm-line-target:hover { background-color: rgba(217, 180, 91, 0.12); }
.sm-line-target:focus { border-width: 2px; border-color: #d9b45b; }
.sm-contact-target { position: absolute; width: 16px; height: 16px; min-width: 0; min-height: 0; padding: 0; margin: 0; border-width: 0; border-radius: 8px; background-color: transparent; }
.sm-contact-target:focus { border-width: 2px; border-color: #d9b45b; }
.sm-map-warning { position: absolute; bottom: 10px; left: 12px; right: 12px; white-space: normal; color: #ef7b83; background-color: #101114; font-size: 15px; }
.sm-compact { padding: 12px 16px; }
.sm-compact .sm-title { font-size: 20px; margin-right: 12px; }
.sm-compact .sm-detail { width: 32%; min-width: 220px; margin-left: 12px; padding-left: 12px; }
.sm-narrow .sm-body { flex-direction: column; }
.sm-narrow .sm-canvas-host { flex-grow: 3; min-height: 180px; }
.sm-narrow .sm-detail { width: auto; max-width: none; min-width: 0; min-height: 100px; flex-grow: 2; flex-basis: 0; margin: 12px 0 0; padding: 10px 0 0; border-left-width: 0; border-top-width: 1px; border-top-color: #343238; }
.sm-narrow .sm-stories { flex-basis: 100%; margin: 8px 0; }
.sm-narrow .sm-relations-filter { width: 210px; }
