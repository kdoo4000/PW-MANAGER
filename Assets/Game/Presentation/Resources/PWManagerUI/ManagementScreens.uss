.mg-page .ops-body > .ops-list-pane { flex-grow:3; }
.mg-page .ops-body > .ops-detail-pane { flex-grow:7; padding-left:24px; }
.mg-page .ops-table-heading { background-color:transparent; }
.mg-list-row { flex-direction:row; align-items:center; min-height:108px; padding:12px; margin-bottom:8px; border-width:1px; border-color:#343238; background-color:#18191d; }
.mg-list-row:hover { border-color:#918c84; background-color:#222327; }
.mg-list-row.ops-selected { border-left-width:3px; border-left-color:#d9b45b; background-color:#29271f; }
.mg-list-row:focus { border-color:#d9b45b; }
.mg-list-copy { flex-grow:1; flex-basis:0; min-width:0; }
.mg-list-name { font-size:16px; white-space:normal; color:#f4f0e7; margin-bottom:8px; -unity-font-definition:url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf"); }
.mg-caption { font-size:13px; color:#a9a399; white-space:normal; }
.mg-list-belt { width:104px; height:70px; flex-shrink:0; margin-right:12px; }
.mg-list-row .ops-people { margin-top:6px; }
.mg-list-row .wrestler-link { color:#d9d6cf; font-size:13px; }
.mg-belt { min-width:0; min-height:0; }
.mg-belt-showcase { flex-grow:1; height:210px; margin:18px 0; }
.mg-header { flex-direction:row; align-items:center; justify-content:space-between; margin-bottom:18px; }
.mg-header .ops-detail-title { flex-grow:1; flex-basis:0; margin:0 18px 0 0; }
.mg-overview { flex-direction:row; flex-wrap:wrap; margin-top:16px; }
.mg-overview-title { flex-grow:1; flex-basis:280px; min-width:0; margin-right:24px; }
.mg-overview-champion { flex-grow:1; flex-basis:240px; min-width:0; background-color:#191a1e; padding:16px; }
.mg-stat-strip { flex-direction:row; flex-wrap:wrap; margin:18px 0; padding:16px 0; border-top-width:1px; border-bottom-width:1px; border-color:#343238; }
.mg-stat { flex-grow:1; flex-basis:110px; min-width:0; padding:0 12px; margin:6px 0; }
.mg-stat-value { font-size:23px; color:#f4f0e7; margin-bottom:6px; white-space:normal; -unity-font-definition:url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf"); }
.mg-lineup { flex-direction:row; flex-wrap:wrap; align-items:flex-start; margin:12px 0; }
.mg-lineup > .mg-wrestler { max-width:360px; }
.mg-lineup .mg-photo { height:220px; }
.mg-wrestler { flex-grow:1; flex-basis:150px; min-width:120px; max-width:260px; margin:0 12px 16px 0; padding:10px; background-color:#1a1b1f; border-bottom-width:2px; border-bottom-color:#49454a; }
.mg-photo { height:155px; min-height:0; width:100%; margin:0; padding:0; border-width:0; border-radius:0; background-color:#24262c; }
.mg-photo:hover { background-color:#34343b; }
.mg-photo:focus { border-width:1px; border-color:#d9b45b; }
.mg-photo .wrestler-portrait-frame { width:100%; height:100%; padding:0; margin:0; border-width:0; background-color:transparent; }
.mg-photo .wrestler-portrait-image { width:100%; height:100%; }
.mg-photo .wrestler-portrait-name { display:none; }
.mg-wrestler > .wrestler-link { color:#f4f0e7; font-size:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; background-color:transparent; border-width:0; margin:8px 0 0; padding:0; -unity-text-align:middle-left; }
.mg-leader-mark { color:#d9b45b; font-size:12px; margin-top:8px; }
.mg-member-name { flex-direction:row; align-items:center; margin:0 20px 10px 0; }
.mg-member-name .mg-leader-mark { margin:0 0 0 8px; }
.mg-member-name .wrestler-link { font-size:16px; }
.mg-miniature { width:48px; height:48px; flex-shrink:0; margin-right:8px; }
.mg-miniature .mg-photo { height:48px; }
.mg-list-faces { flex-direction:row; flex-wrap:wrap; margin-top:8px; }
.mg-editor .ops-list-pane { display:none; }
.mg-editor .ops-detail-pane { border-left-width:0; padding-left:0; }
.mg-page.mg-editor .ops-body > .ops-detail-pane { border-left-width:0; padding-left:0; }
.mg-editor-layout { flex-direction:row; flex-grow:1; min-height:0; }
.mg-editor-settings { flex-grow:4; flex-basis:0; min-width:220px; margin-right:24px; }
.mg-editor-members { flex-grow:6; flex-basis:0; min-width:0; }
.mg-editor .ops-detail-pane { flex-grow:1; }
.mg-roster-row { flex-direction:row; align-items:center; min-height:66px; padding:6px 10px; border-bottom-width:1px; border-color:#343238; }
.mg-roster-row:hover { background-color:#23242a; }
.mg-roster-row > .wrestler-link { flex-grow:1; flex-basis:0; min-width:0; color:#f4f0e7; margin:0 12px; padding:4px 0; border-width:0; background-color:transparent; -unity-text-align:middle-left; white-space:normal; }
.mg-roster-row > Toggle { margin-right:12px; }
.mg-selected-grid { flex-direction:row; flex-wrap:wrap; align-items:flex-start; }
.mg-selected-grid .mg-wrestler { flex-basis:160px; }
.mg-member-actions { flex-direction:row; flex-wrap:wrap; margin-top:12px; }
.mg-member-actions .ops-action { flex-grow:1; min-width:0; padding:5px 8px; margin:0 4px 5px 0; font-size:12px; }
.mg-leader-selected { border-color:#d9b45b; color:#d9b45b; }
.mg-member-options { min-height:160px; max-height:600px; }
.mg-picker-grid { flex-direction:row; flex-wrap:wrap; }
.mg-picker-faces { flex-direction:row; }
.mg-picker-faces > .mg-wrestler { flex-grow:1; }
.mg-picker-card { flex-grow:1; flex-basis:145px; min-width:120px; max-width:240px; margin:0 10px 12px 0; padding:10px; border-width:1px; border-color:#343238; background-color:#1a1b1f; }
.mg-picker-card.ops-selected { border-color:#d9b45b; background-color:#29271f; }
.mg-picker-card .mg-wrestler { margin:0; padding:0; max-width:none; min-width:0; border-width:0; background-color:transparent; }
.mg-picker-card .mg-photo { height:112px; }
.mg-picker-card > Toggle { margin-top:10px; color:#d9d6cf; }
.mg-picker-card > Toggle > .unity-base-field__label { min-width:0; flex-basis:0; flex-grow:1; margin-right:8px; white-space:normal; }
.mg-picker-card > Toggle > .unity-base-field__input { flex-grow:0; flex-shrink:0; min-width:24px; }
.mg-page .ops-confirm { margin-bottom:16px; }
.mg-page .mg-footer { border-top-width:1px; border-color:#343238; padding-top:12px; }
.ops-narrow.mg-page .ops-body > .ops-detail-pane { padding-left:0; }
.ops-narrow.mg-page .mg-editor-layout { flex-direction:column; }
.ops-narrow.mg-page .mg-editor-settings { flex-basis:auto; margin-right:0; min-width:0; }
.ops-narrow.mg-page .mg-editor-members { flex-basis:auto; }
.ops-narrow.mg-page .mg-belt-showcase { height:150px; }
.ops-narrow.mg-page .mg-editor .ops-detail-pane { border-top-width:0; }
