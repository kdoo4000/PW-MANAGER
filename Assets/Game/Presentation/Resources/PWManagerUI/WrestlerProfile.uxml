<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/Presentation/Resources/PWManagerUI/WrestlerProfile.uss?fileID=7433441132597879392&amp;guid=dee1fd46bff057449ab3a4ffcaa78f0a&amp;type=3#WrestlerProfile"/>
    <Style src="project://database/Assets/Game/Presentation/Resources/PWManagerUI/Dashboard.uss?fileID=7433441132597879392&amp;guid=a1df28c29473e28419939810bd3da8c2&amp;type=3#Dashboard"/>
    <Style src="project://database/Assets/Game/Presentation/Resources/PWManagerUI/PWManagerTheme.uss?fileID=7433441132597879392&amp;guid=b725eb90bca57e6419feb728bb92cca2&amp;type=3#PWManagerTheme"/>
    <ui:VisualElement name="wrestler-profile" class="wp-screen">
        <ui:VisualElement name="wp-sidebar" class="wp-sidebar sidebar">
            <ui:VisualElement class="wp-brand brand">
                <ui:Label name="wp-promotion" text="PROMOTION" class="wp-brand-title brand-title" style="margin-top: 1px;"/>
                <ui:Label text="PROMOTION OFFICE" class="wp-brand-subtitle brand-subtitle"/>
            </ui:VisualElement>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-home" class="wp-nav-icon nav-icon"/>
                <ui:Label text="홈" class="nav-label"/>
                <ui:Label name="wp-home-badge" text="0" class="badge"/>
            </ui:Button>
            <ui:VisualElement class="wp-nav-divider divider"/>
            <ui:Button class="wp-nav nav active">
                <ui:VisualElement name="wp-icon-roster" class="wp-nav-icon nav-icon"/>
                <ui:Label text="로스터" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-teams" class="wp-nav-icon nav-icon"/>
                <ui:Label text="태그팀·스테이블" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-locker" class="wp-nav-icon nav-icon"/>
                <ui:Label text="라커룸" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-scout" class="wp-nav-icon nav-icon"/>
                <ui:Label text="스카우팅" class="nav-label"/>
            </ui:Button>
            <ui:VisualElement class="wp-nav-divider divider"/>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-show" class="wp-nav-icon nav-icon"/>
                <ui:Label text="쇼" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-story" class="wp-nav-icon nav-icon"/>
                <ui:Label text="스토리라인" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-title" class="wp-nav-icon nav-icon"/>
                <ui:Label text="챔피언십" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-tournament" class="wp-nav-icon nav-icon"/>
                <ui:Label text="토너먼트" class="nav-label"/>
            </ui:Button>
            <ui:VisualElement class="wp-nav-divider divider"/>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-schedule" class="wp-nav-icon nav-icon"/>
                <ui:Label text="일정" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-staff" class="wp-nav-icon nav-icon"/>
                <ui:Label text="시설·스태프" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-company" class="wp-nav-icon nav-icon"/>
                <ui:Label text="단체 정보" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-finance" class="wp-nav-icon nav-icon"/>
                <ui:Label text="재정" class="nav-label"/>
            </ui:Button>
            <ui:VisualElement class="wp-nav-divider divider"/>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-report" class="wp-nav-icon nav-icon"/>
                <ui:Label text="리포트" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-world" class="wp-nav-icon nav-icon"/>
                <ui:Label text="월드" class="nav-label"/>
            </ui:Button>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-history" class="wp-nav-icon nav-icon"/>
                <ui:Label text="기록" class="nav-label"/>
            </ui:Button>
            <ui:VisualElement class="wp-sidebar-spacer sidebar-spacer"/>
            <ui:Button class="wp-nav nav">
                <ui:VisualElement name="wp-icon-settings" class="wp-nav-icon nav-icon"/>
                <ui:Label text="설정" class="nav-label"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="wp-workspace">
            <ui:VisualElement name="wp-topbar" class="wp-topbar">
                <ui:Button name="wrestler-profile-back" text="‹" class="wp-back"/>
                <ui:Button text="›" class="wp-forward"/>
                <ui:Label name="wp-breadcrumb" text="선수 / 개요" class="wp-breadcrumb" style="margin-left: 10px; padding-left: 4px;"/>
                <ui:VisualElement class="wp-top-spacer"/>
                <ui:VisualElement class="wp-top-stat">
                    <ui:Label text="현재 날짜" class="wp-eyebrow" style="margin-top: 2px; padding-top: 2px; padding-bottom: 2px;"/>
                    <ui:Label name="wp-date" text="—" class="wp-top-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="wp-top-stat">
                    <ui:Label text="현재 자금" class="wp-eyebrow" style="margin-top: 2px; padding-top: 2px; padding-bottom: 2px;"/>
                    <ui:Label name="wp-cash" text="—" class="wp-top-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="wp-top-stat wide">
                    <ui:Label text="다음 쇼 일정" class="wp-eyebrow" style="margin-top: 2px; padding-top: 2px; padding-bottom: 2px;"/>
                    <ui:Label name="wp-next-show" text="—" class="wp-top-value"/>
                </ui:VisualElement>
                <ui:Button text="알림  0" class="wp-small-button"/>
                <ui:Button text="시간 진행  ›" class="wp-primary-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="wp-content">
                <ui:VisualElement class="wp-tabs">
                    <ui:Label text="개요" class="wp-tab active"/>
                    <ui:Label text="관계" class="wp-tab"/>
                    <ui:Label text="계약" class="wp-tab"/>
                </ui:VisualElement>
                <ui:VisualElement class="wp-scroll">
                    <ui:VisualElement class="wp-layout">
                        <ui:VisualElement class="wp-layout-top">
                            <ui:VisualElement class="wp-card wp-player-panel">
                                <ui:Label text="프로필" class="wp-card-title"/>
                                <ui:VisualElement class="wp-profile-hero">
                                    <ui:VisualElement class="wp-avatar">
                                        <ui:Label name="wp-initials" text="PW" class="wp-initials"/>
                                    </ui:VisualElement>
                                    <ui:Label name="wp-name" text="선수 이름" class="wp-name"/>
                                    <ui:VisualElement class="wp-profile-physical">
                                        <ui:Label name="wp-gender" text="—"/>
                                        <ui:Label name="wp-age" text="—"/>
                                        <ui:Label name="wp-height" text="—"/>
                                        <ui:Label name="wp-weight" text="—"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-profile-details">
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="본명"/>
                                        <ui:Label name="wp-legal-name" text="—"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="경력"/>
                                        <ui:Label name="wp-career" text="—"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="현재 위상"/>
                                        <ui:Label name="wp-card-status" text="—"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="소속 태그팀"/>
                                        <ui:Label name="wp-tag" text="없음"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="소속 스테이블"/>
                                        <ui:Label name="wp-stable" text="없음"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="wp-card wp-abilities-panel">
                                <ui:VisualElement class="wp-section-heading">
                                    <ui:Label text="능력치" class="wp-card-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-ability-columns">
                                    <ui:VisualElement name="wp-match-abilities" class="wp-ability-column"/>
                                    <ui:VisualElement name="wp-promo-abilities" class="wp-ability-column"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-ability-summary">
                                    <ui:VisualElement class="wp-summary-line">
                                        <ui:VisualElement class="wp-summary-cell">
                                            <ui:Label text="종합 경기 능력" class="wp-ability-label"/>
                                            <ui:Label name="wp-match-overall" text="—" class="wp-ability-value"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="wp-summary-cell">
                                            <ui:Label text="종합 프로모 능력" class="wp-ability-label"/>
                                            <ui:Label name="wp-promo-overall" text="—" class="wp-ability-value"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-summary-line">
                                        <ui:VisualElement class="wp-summary-cell">
                                            <ui:Label text="경기 잠재력" class="wp-ability-label"/>
                                            <ui:Label name="wp-match-potential" text="—" class="wp-ability-value"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="wp-summary-cell">
                                            <ui:Label text="프로모 잠재력" class="wp-ability-label"/>
                                            <ui:Label name="wp-promo-potential" text="—" class="wp-ability-value"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="wp-top-side">
                                <ui:VisualElement class="wp-card wp-half-card wp-moves-card">
                                    <ui:VisualElement class="wp-moves-header">
                                        <ui:Label text="무브셋" class="wp-card-title"/>
                                        <ui:Button name="wp-edit-moves" text="변경" class="wp-save-button"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-move-section">
                                        <ui:Label text="시그니처" class="wp-move-kind"/>
                                        <ui:VisualElement class="wp-move-values">
                                            <ui:Label name="wp-signature-1" text="—"/>
                                            <ui:Label name="wp-signature-2" text="—"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-moves-rule"/>
                                    <ui:VisualElement class="wp-move-section">
                                        <ui:Label text="피니셔" class="wp-move-kind"/>
                                        <ui:VisualElement class="wp-move-values">
                                            <ui:Label name="wp-finisher-1" text="—"/>
                                            <ui:Label name="wp-finisher-2" text="—"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-card wp-half-card">
                                    <ui:Label text="팬 반응" class="wp-card-title"/>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="매니아"/>
                                        <ui:Label name="wp-mania" text="—"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="라이트"/>
                                        <ui:Label name="wp-light" text="—"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="패밀리"/>
                                        <ui:Label name="wp-family" text="—"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-rule"/>
                                    <ui:VisualElement class="wp-info-row">
                                        <ui:Label text="전체 관심 강도"/>
                                        <ui:Label name="wp-fan-total" text="— / 100" class="attention-color"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="wp-layout-bottom">
                            <ui:VisualElement class="wp-card wp-bottom-card" style="justify-content: space-between;">
                                <ui:Label text="현재 상태" class="wp-card-title"/>
                                <ui:VisualElement class="wp-info-row">
                                    <ui:Label text="활동 가능"/>
                                    <ui:Label name="wp-availability" text="—" class="positive"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-info-row">
                                    <ui:Label text="컨디션"/>
                                    <ui:Label name="wp-condition" text="—"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-info-row">
                                    <ui:Label text="만족도"/>
                                    <ui:Label name="wp-satisfaction" text="—"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-info-row">
                                    <ui:Label text="부상"/>
                                    <ui:Label name="wp-injury" text="—"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-info-row">
                                    <ui:Label text="모멘텀"/>
                                    <ui:Label name="wp-momentum" text="—"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="wp-card wp-style-card wp-promo-card">
                                <ui:VisualElement class="wp-card-heading wp-style-heading">
                                    <ui:Label text="경기 스타일" class="wp-card-title"/>
                                    <ui:Button name="wp-save-match-style" text="저장" class="wp-save-button"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="wp-match-style-options" class="wp-choice-grid"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="wp-card wp-style-card">
                                <ui:VisualElement class="wp-card-heading">
                                    <ui:Label text="프로모 역할 · 성향" class="wp-card-title"/>
                                    <ui:Button name="wp-save-promo-style" text="저장" class="wp-save-button"/>
                                </ui:VisualElement>
                                <ui:Label text="역할" class="wp-choice-label"/>
                                <ui:VisualElement name="wp-role-options" class="wp-promo-choice-row"/>
                                <ui:Label text="성향" class="wp-choice-label second" style="margin-top: 25px;"/>
                                <ui:VisualElement name="wp-disposition-options" class="wp-promo-choice-row"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="wp-card wp-bottom-card wp-last-card">
                                <ui:Label text="출전 기록" class="wp-card-title"/>
                                <ui:VisualElement class="wp-record-grid">
                                    <ui:VisualElement class="wp-record">
                                        <ui:Label name="wp-matches" text="0" class="wp-record-value"/>
                                        <ui:Label text="경기"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-record">
                                        <ui:Label name="wp-wins" text="0" class="wp-record-value positive"/>
                                        <ui:Label text="승"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-record">
                                        <ui:Label name="wp-draws" text="0" class="wp-record-value attention-color"/>
                                        <ui:Label text="무"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-record">
                                        <ui:Label name="wp-losses" text="0" class="wp-record-value negative"/>
                                        <ui:Label text="패"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-record-grid wp-record-grid-secondary">
                                    <ui:VisualElement class="wp-record">
                                        <ui:Label name="wp-championships" text="0" class="wp-record-value"/>
                                        <ui:Label text="통산 챔피언십"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-record">
                                        <ui:Label name="wp-world-championships" text="0" class="wp-record-value attention-color"/>
                                        <ui:Label text="통산 월드 챔피언"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wp-record">
                                        <ui:Label name="wp-win-streak" text="0" class="wp-record-value positive"/>
                                        <ui:Label text="현재 연승"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="wp-info-row">
                                    <ui:Label text="최근 경기"/>
                                    <ui:Label name="wp-recent-result" text="기록 없음"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
