.story-management.wr-screen { flex-grow: 1; min-height: 0; min-width: 0; padding: 14px 0 0; background-color: transparent; }
.wr-toolbar { flex-direction: row; flex-wrap: wrap; align-items: flex-end; flex-shrink: 0; margin-bottom: 12px; }
.wr-toolbar .unity-text-field { flex-grow: 2; flex-basis: 160px; min-width: 0; margin: 0 12px 0 0; }
.wr-toolbar .unity-popup-field { flex-grow: 1; flex-basis: 120px; min-width: 0; margin: 0 12px 0 0; }
.wr-map-actions { flex-direction: row; align-items: center; }
.wr-body { flex-grow: 1; min-height: 0; min-width: 0; flex-direction: row; }
.wr-map-host { flex-grow: 2.3; flex-basis: 0; min-width: 0; min-height: 0; margin-right: 16px; position: relative; }
.wr-map { flex-grow: 1; min-width: 0; min-height: 0; overflow: hidden; background-color: #101114; border-width: 1px; border-color: var(--pw-soft-border); }
.wr-map:focus { border-color: var(--pw-accent); }
.wr-center { border-color: var(--pw-accent); border-width: 3px; }
.wr-group-frame { position: absolute; border-width: 1px; border-color: #68b8ff; border-radius: 3px; background-color: #161b22; }
.wr-tag-frame { border-color: #8bc7ff; background-color: transparent; }
.wr-node.wr-selected { border-color: var(--pw-accent); border-width: 3px; background-color: var(--pw-selected); }
.wr-node-affinity { height: 18px; margin: 0; -unity-text-align: middle-center; color: var(--pw-text-muted); font-size: 12px; }
.wr-map-empty { position: absolute; left: 16px; right: 16px; bottom: 16px; padding: 8px; margin: 0; background-color: #101114; color: var(--pw-text-muted); white-space: normal; -unity-text-align: middle-center; }
.wr-detail { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; padding-left: 16px; border-left-width: 1px; border-left-color: var(--pw-soft-border); }
.wr-detail .unity-scroll-view__content-container { padding-right: 8px; }
.wr-detail .unity-scroll-view__horizontal-scroller { display: none; }
.wr-detail Label { white-space: normal; }
.wr-pair-summary { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 12px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: var(--pw-soft-border); }
.wr-pair-summary Label { color: var(--pw-text-strong); }
.wr-narrow .wr-body { flex-direction: column; }
.wr-narrow .wr-map-host { flex-grow: 1.5; margin-right: 0; margin-bottom: 12px; }
.wr-narrow .wr-detail { flex-grow: 1; padding-left: 0; padding-top: 12px; border-left-width: 0; border-top-width: 1px; border-top-color: var(--pw-soft-border); }
.wr-map { flex-grow: 3; flex-basis: 0; }
.wr-neutral-shelf { flex-grow: 1; flex-basis: 0; min-height: 110px; max-height: 220px; margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: var(--pw-soft-border); }
.wr-neutral-heading { flex-shrink: 0; margin-bottom: 8px; color: var(--pw-text-muted); font-size: 14px; }
.wr-neutral-list { flex-grow: 1; min-height: 0; }
.wr-neutral-list .unity-scroll-view__content-container { flex-direction: row; align-items: flex-start; }
.wr-neutral-node { flex-shrink: 0; margin-right: 12px; }
