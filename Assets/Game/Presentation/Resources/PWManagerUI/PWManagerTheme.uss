:root {
    --pw-bg: #090a0c;
    --pw-surface: #101114;
    --pw-card: #141518;
    --pw-card-raised: #1a1b1f;
    --pw-border: #343238;
    --pw-divider: #29282d;
    --pw-text: #d9d6cf;
    --pw-text-strong: #f4f0e7;
    --pw-text-muted: #918c84;
    --pw-accent: #d9b45b;
    --pw-accent-deep: #8f2f2d;
    --pw-panel: rgba(20, 21, 24, 0.66);
    --pw-inner: rgba(20, 21, 24, 0.42);
    --pw-row: rgba(20, 21, 24, 0.28);
    --pw-row-alt: rgba(20, 21, 24, 0.34);
    --pw-row-hover: rgba(20, 21, 24, 0.52);
    --pw-selected: rgba(217, 180, 91, 0.16);
    --pw-unread: rgba(23, 43, 64, 0.72);
    --pw-unread-hover: rgba(29, 53, 77, 0.82);
    --pw-state-blue: #68b8ff;
    --pw-state-green: #73d39a;
    --pw-state-red: #e15761;
    --pw-state-purple: #c7a5ff;
    --pw-soft-border: rgba(217, 214, 207, 0.14);
}

* {
    -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Regular.ttf");
}

Button, TextField, DropdownField,
.nav, .tab, .wp-nav, .wp-tab, .wp-choice,
.small-button, .primary-button, .wp-small-button, .wp-primary-button,
.setup-button, .title-button, .table-header-button {
    -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Regular.ttf");
    -unity-font-style: normal;
}

Button {
    transition-duration: 0.08s;
}

Button:active {
    scale: 0.97 0.97;
}

.brand-title, .card-title, .wp-brand-title, .wp-card-title,
.title-button-text, .setup-title, .wizard-title, .cost-title,
.venue-card-title, .roster-name, .roster-grade,
.wp-name, .wp-record-value, .wp-ability-value {
    -unity-font-definition: url("project://database/Assets/Game/Presentation/Resources/PWManagerUI/Fonts/SEBANGGothic-Bold.ttf");
    -unity-font-style: normal;
}

.dashboard, .wizard, .new-game-screen, .wp-screen {
    background-color: var(--pw-bg);
    color: var(--pw-text);
}

.sidebar, .topbar, .wp-sidebar, .wp-topbar,
.wizard-header, .wizard-progress, .wizard-footer {
    background-color: var(--pw-surface);
    border-color: var(--pw-divider);
}

.card, .wp-card, .cost-panel, .info-card, .review-card, .venue-card {
    background-color: var(--pw-card);
    border-color: var(--pw-border);
    border-radius: 4px;
}

.card, .wp-card {
    padding: 16px;
}

.card-title, .wp-card-title, .setup-title, .wizard-title, .cost-title {
    color: var(--pw-text-strong);
}

.muted, .wp-muted, .wp-card-help, .field-help, .setup-copy,
.summary-label, .selection-detail, .venue-stat-label {
    color: var(--pw-text-muted);
}

.link, .task-link, .wrestler-link, .wp-preview-state {
    color: var(--pw-accent);
}

.small-button, .wp-small-button, .setup-button.secondary, .wp-choice {
    color: #b8c4d9;
    background-color: var(--pw-card-raised);
    border-width: 1px;
    border-color: var(--pw-border);
    border-radius: 3px;
}

.primary-button, .wp-primary-button, .setup-button.start {
    color: #ffffff;
    background-color: var(--pw-accent-deep);
    border-width: 0;
    border-radius: 3px;
}

.title-background {
    -unity-background-image-tint-color: #d8c9ad;
}

.title-vignette {
    background-color: rgba(6, 5, 4, 0.52);
}

.title-menu, .new-game-setup {
    border-left-color: var(--pw-accent);
}

.menu-kicker, .field-label, .wizard-kicker,
.progress-item.done, .accent, .selection-cost, .money-value {
    color: var(--pw-accent);
}

.title-button-arrow {
    color: var(--pw-accent);
}

.title-button:hover, .title-button:focus {
    border-color: var(--pw-accent);
}

.title-button.primary {
    color: #ffffff;
    background-color: #6f2525;
    border-color: var(--pw-accent);
}

.progress-item.active {
    border-bottom-color: var(--pw-accent);
}

.selection-row.selected {
    background-color: #2b2419;
    border-color: var(--pw-accent);
}

.info-card, .review-card {
    border-left-color: var(--pw-accent);
}

.venue-card.selected {
    background-color: #2b2419;
    border-color: var(--pw-accent);
}

.venue-state.selected {
    color: #ffffff;
    background-color: var(--pw-accent-deep);
}

.nav, .wp-nav, .tab, .wp-tab, .wp-choice,
.small-button, .primary-button, .wp-small-button, .wp-primary-button,
.setup-button, .title-button, .venue-card {
    transition-duration: 0.15s;
}

.nav.active, .wp-nav.active, .tab.active-tab, .wp-tab.active, .wp-choice.selected {
    background-color: #302719;
    border-color: var(--pw-accent);
    color: var(--pw-text-strong);
}

.sidebar > .nav,
.wp-sidebar > .wp-nav {
    background-color: var(--pw-surface);
}

.sidebar > .nav:hover,
.wp-sidebar > .wp-nav:hover {
    background-color: #1a1b1f;
}

.sidebar > .nav.active,
.wp-sidebar > .wp-nav.active,
.tabs > .tab.active-tab,
.wp-tabs > .wp-tab.active,
.roster-tabs > .roster-tab.roster-tab-active {
    background-color: #302719;
    color: var(--pw-text-strong);
    border-bottom-color: var(--pw-accent);
}

.sidebar > .nav.active .nav-label,
.wp-sidebar > .wp-nav.active .nav-label {
    color: var(--pw-text-strong);
}

.card-title, .wp-card-title, .show-schedule-title, .show-plan-name,
.message-heading, .roster-name, .show-editor-title {
    letter-spacing: 0.6px;
}

.card, .wp-card, .message-list-pane, .message-detail-pane,
.roster-panel, .show-plan-card, .show-editor-dialog {
    border-top-color: #454047;
}

.brand-subtitle, .link, .task-link, .blue-text,
.message-row.unread .message-sender, .message-detail-sender,
.wrestler-link, .wrestler-link.roster-name-link,
.wrestler-link.show-editor-wrestler-name, .show-editor-selected-count,
.show-editor-rule-arrow, .wp-preview-state, .save-load-row-action {
    color: var(--pw-accent);
}

.nav.active, .wp-nav.active, .tab.active-tab, .wp-tab.active,
.show-editor-rule-option.selected, .wp-choice.selected {
    background-color: #302719;
    border-color: var(--pw-accent);
}

.message-row.selected, .message-row.unread.selected {
    background-color: #302719;
    border-left-color: var(--pw-accent);
}

.progress-fill, .show-duration-fill,
.show-ticket-controls .unity-base-slider__dragger {
    background-color: var(--pw-accent);
}

.primary-button, .wp-primary-button, .message-open-target,
.show-schedule-title-edit, .schedule-title-save, .show-schedule-open,
.show-action-button, .show-save-button, .show-confirm-button,
.show-detail-action.edit, .show-editor-submit, .manual-save-button,
.wp-save-button {
    background-color: #5a461e;
    border-color: var(--pw-accent);
    color: var(--pw-text-strong);
}

.message-avatar, .show-editor-wrestler.selected .show-editor-wrestler-portrait {
    border-color: var(--pw-accent);
}

.message-avatar, .wrestler-portrait-initials, .show-editor-wrestler-initials {
    color: var(--pw-accent);
}

.unity-scroll-view__vertical-scroller {
    width: 10px;
    margin: 4px 2px 4px 0;
    background-color: transparent;
}

.unity-scroll-view__horizontal-scroller {
    height: 10px;
    margin: 0 4px 2px 4px;
    background-color: transparent;
}

.unity-scroller__low-button, .unity-scroller__high-button {
    display: none;
}

.unity-scroller__slider {
    flex-grow: 1;
    margin: 0;
}

.unity-base-slider__tracker {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: #29282d;
    background-image: none;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    width: 7px;
    min-width: 7px;
    min-height: 34px;
    border-width: 0;
    border-radius: 4px;
    background-color: #62502c;
    background-image: none;
}

.unity-scroll-view__horizontal-scroller .unity-base-slider__dragger {
    height: 7px;
    min-width: 34px;
    min-height: 7px;
    border-width: 0;
    border-radius: 4px;
    background-color: #62502c;
    background-image: none;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__dragger-border,
.unity-scroll-view__horizontal-scroller .unity-base-slider__dragger-border {
    display: none;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover,
.unity-scroll-view__horizontal-scroller .unity-base-slider__dragger:hover {
    background-color: #8a7138;
}
