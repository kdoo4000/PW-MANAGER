<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Dashboard.uss"/>
<ui:VisualElement name="show-schedule-content" class="show-schedule-content hidden" style="display: none;">
    <ui:VisualElement class="show-schedule-heading">
        <ui:VisualElement>
            <ui:Label text="전체 쇼 일정" class="show-schedule-title"/>
            <ui:Label name="show-schedule-caption" text="예정된 쇼와 지난 쇼를 확인합니다" class="show-schedule-caption"/>
        </ui:VisualElement>
        <ui:VisualElement class="show-schedule-totals">
            <ui:Label name="show-schedule-upcoming" text="예정 0" class="show-schedule-total upcoming"/>
            <ui:Label name="show-schedule-completed" text="완료 0" class="show-schedule-total"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="show-schedule-columns">
        <ui:VisualElement class="show-schedule-column regular">
            <ui:VisualElement class="show-schedule-column-heading">
                <ui:Label text="정규 쇼" class="show-schedule-column-title"/>
                <ui:Button name="schedule-regular-title-edit" text="제목 설정" class="show-schedule-title-edit"/>
            </ui:VisualElement>
            <ui:ScrollView mode="Vertical" class="show-schedule-scroll">
                <ui:VisualElement name="show-schedule-regular-rows" class="show-schedule-rows"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="show-schedule-column ppv">
            <ui:VisualElement class="show-schedule-column-heading">
                <ui:Label text="PPV" class="show-schedule-column-title"/>
                <ui:Button name="schedule-ppv-title-edit" text="제목 설정" class="show-schedule-title-edit"/>
            </ui:VisualElement>
            <ui:ScrollView mode="Vertical" class="show-schedule-scroll">
                <ui:VisualElement name="show-schedule-ppv-rows" class="show-schedule-rows"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="schedule-title-overlay" class="schedule-title-overlay hidden">
        <ui:VisualElement class="schedule-title-dialog">
            <ui:VisualElement class="schedule-title-heading">
                <ui:Label name="schedule-title-dialog-title" text="쇼 제목 설정" class="schedule-title-dialog-title"/>
                <ui:Button name="schedule-title-close" text="×" class="schedule-title-close"/>
            </ui:VisualElement>
            <ui:ScrollView mode="Vertical" class="schedule-title-scroll">
                <ui:VisualElement name="schedule-title-fields" class="schedule-title-fields"/>
            </ui:ScrollView>
            <ui:Label name="schedule-title-message" text="" class="schedule-title-message"/>
            <ui:VisualElement class="schedule-title-footer">
                <ui:Button name="schedule-title-cancel" text="취소" class="schedule-title-cancel"/>
                <ui:Button name="schedule-title-save" text="저장" class="schedule-title-save"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:VisualElement>
</ui:UXML>
