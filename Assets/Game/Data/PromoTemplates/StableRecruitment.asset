%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89d279c533bb29442a78e6f72653bc22, type: 3}
  m_Name: StableRecruitment
  m_EditorClassIdentifier: PWMANAGER.Data::PWManager.Data.Definitions.PromoTemplateGraphAsset
  TemplateId: promo_stable_recruitment
  KoreanName: 스테이블 영입
  EnglishName: Stable Recruitment
  Nodes:
  - Id: start
    Type: 0
    Title: Recruitment Begins
    Description: The stable or tag team calls out a prospective member.
    Position: {x: 29, y: 11}
  - Id: approach
    Type: 1
    Title: Make the Approach
    Description: The recruiting side explains why the target belongs with them.
    Position: {x: 517, y: 11}
  - Id: offer
    Type: 1
    Title: Present the Offer
    Description: 
    Position: {x: 1067, y: 11}
  - Id: response
    Type: 2
    Title: Target Responds
    Description: Book the target to accept, reject, or keep negotiating.
    Position: {x: 1664, y: 11}
  - Id: join_change
    Type: 6
    Title: Membership Change
    Description: Queue the target joining the recruiting team or stable.
    Position: {x: 2195, y: -156}
  - Id: joined
    Type: 5
    Title: Recruitment Accepted
    Description: The target joins. Evaluation changes the quality and side effects,
      not this booked result.
    Position: {x: 2822, y: -156}
  - Id: rejected
    Type: 5
    Title: Recruitment Rejected
    Description: The target refuses the offer. The refusal may create or intensify
      conflict.
    Position: {x: 2289, y: 11}
  - Id: pending
    Type: 5
    Title: Negotiations Continue
    Description: No membership change occurs yet; the open offer can continue in
      a later promo.
    Position: {x: 2195, y: 196}
  Edges:
  - Id: edge_start_approach
    FromNodeId: start
    ToNodeId: approach
    Label: Call Out
  - Id: edge_approach_offer
    FromNodeId: approach
    ToNodeId: offer
    Label: Pitch
  - Id: edge_offer_response
    FromNodeId: offer
    ToNodeId: response
    Label: Decision
  - Id: edge_accept_change
    FromNodeId: response
    ToNodeId: join_change
    Label: Accept
  - Id: edge_change_joined
    FromNodeId: join_change
    ToNodeId: joined
    Label: Apply
  - Id: edge_reject
    FromNodeId: response
    ToNodeId: rejected
    Label: Reject
  - Id: edge_negotiate
    FromNodeId: response
    ToNodeId: pending
    Label: Negotiate
