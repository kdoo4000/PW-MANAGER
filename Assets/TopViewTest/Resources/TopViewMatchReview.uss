#match-review-controls {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 16px;
    padding: 12px;
    background-color: rgb(14, 19, 26);
    color: rgb(235, 239, 244);
    font-size: 15px;
}
.review-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.review-field { flex-grow: 1; flex-basis: 110px; margin-right: 8px; margin-bottom: 6px; }
.review-field > Label { color: rgb(177, 189, 202); margin-bottom: 3px; font-size: 13px; }
.unity-button {
    min-height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    margin: 0 6px 6px 0;
    border-width: 1px;
    border-color: rgb(81, 100, 119);
    border-radius: 3px;
    background-color: rgb(34, 46, 60);
    color: rgb(235, 239, 244);
}
.unity-button:hover { background-color: rgb(48, 67, 86); }
.unity-button:focus { border-color: rgb(130, 199, 240); }
.unity-button:disabled { color: rgb(117, 129, 143); background-color: rgb(25, 32, 42); border-color: rgb(44, 54, 66); }
.unity-button.primary { background-color: rgb(32, 94, 128); }
.unity-button.primary:hover { background-color: rgb(39, 115, 156); }
.unity-base-popup-field__input { min-height: 30px; background-color: rgb(27, 37, 49); color: rgb(235, 239, 244); border-color: rgb(81, 100, 119); }
.unity-base-popup-field__input:focus { border-color: rgb(130, 199, 240); }
.unity-toggle { margin: 0 8px 6px 0; }
#review-position { min-width: 125px; margin-right: 12px; }
#review-timeline { min-height: 28px; }
